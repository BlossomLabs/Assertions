    requires bits < 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures (bits as nat) < 114868520942422389264291807750167091840262401980026081675862648614218004168704
  {}
  lemma AtLeastNext(bits: bv256)
    requires bits >= 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures (bits as nat) >= 114868520942422389264291807750167091840262401980026081675862648614218004168704
