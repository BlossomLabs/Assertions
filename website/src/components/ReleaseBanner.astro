  {beast === 'janus' && (
    <g>
      {strata.map((l) => (
        <>
          <path d={`M0 ${l.y} H${THRESHOLD - 164}`} stroke="var(--color-bp-400)" stroke-opacity={l.o.toFixed(2)} stroke-width="3" stroke-dasharray={l.dash} stroke-linecap="round" />
          <path d={`M${THRESHOLD + 164} ${l.y + 12} H${W}`} stroke="var(--color-bp-400)" stroke-opacity={(l.o + 0.12).toFixed(2)} stroke-width="5" stroke-linecap="round" />
        </>
      ))}
      <!-- the gate: two pillars and an arch in place of the usual ring -->
      <path d={`M752 ${H} V132 A148 124 0 0 1 1048 132 V${H}`} fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-opacity="0.5" stroke-width="4" />
      <path d={`M770 ${H} V134 A130 108 0 0 1 1030 134 V${H}`} fill="none" stroke="var(--color-bp-400)" stroke-opacity="0.3" stroke-width="2" />
      <path d="M740 132 H782 M1018 132 H1060" stroke="var(--color-bp-400)" stroke-opacity="0.5" stroke-width="5" stroke-linecap="round" />
      <circle cx={THRESHOLD} cy="158" r="92" fill="var(--color-bp-500)" fill-opacity="0.18" />
      <path d={`M${THRESHOLD} 8 V${H}`} stroke="var(--color-bp-400)" stroke-opacity="0.5" stroke-width="3" />
      <!-- one eye cut in two by the threshold: the half before it hollow, the half after it solid -->
      {[
        { m: -1, y: 149, fill: 'var(--color-surface-2)' },
        { m: 1, y: 167, fill: 'var(--color-bp-400)' },
      ].map((h) => (
        <g transform={`translate(${THRESHOLD} ${h.y}) scale(${h.m} 1)`}>
          <path d="M9 -44 Q64 -40 96 0 Q64 40 9 44 Z" fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-width="3" stroke-linejoin="round" />
          <circle cx="58" cy="0" r="22" fill="none" stroke="var(--color-bp-400)" stroke-width="3" />
