---
import { ASSERTIONS_ADDRESS } from '../lib/assertions-deployment';
import { COMBINATORS_ADDRESS } from '../lib/combinators-deployment';
import RotatingText from './RotatingText';

const address = ASSERTIONS_ADDRESS;
const combinators = COMBINATORS_ADDRESS;
const short = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;

const networks = ['Ethereum', 'Optimism', 'Base', 'Arbitrum', 'Polygon', 'Gnosis'];
---

<section class="relative pt-32 pb-24 px-6 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[var(--color-bp-500)]/5 blur-[120px]"></div>
  </div>

  <div class="relative max-w-4xl mx-auto text-center">
    <div class="animate-fade-up">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--color-bp-500)]/30 dark:border-[var(--color-bp-400)]/40 bg-[var(--color-bp-500)]/10 dark:bg-[var(--color-bp-400)]/10 text-[var(--color-bp-400)] text-sm font-mono mb-8">
        <span class="size-2 rounded-full bg-[var(--color-ok)] animate-pulse"></span>
        <span>Live on <RotatingText client:load words={networks} /></span>
      </div>
    </div>

    <h1 class="animate-fade-up delay-1 font-mono font-bold text-5xl sm:text-6xl md:text-7xl tracking-tight leading-[1.1] mb-6">
      On-chain assertions<br />
      <span class="text-[var(--color-bp-400)]">for safe governance</span>
    </h1>

    <p class="animate-fade-up delay-2 text-lg sm:text-xl text-[var(--color-ink-2)] max-w-2xl mx-auto mb-4 leading-relaxed">
      Verify view function return values and blockchain state atomically.
      If any assertion fails, the entire transaction reverts.
    </p>

    <p class="animate-fade-up delay-2 font-mono text-sm text-[var(--color-bp-400)] mb-10">
      Assertions judge. Combinators compute.
    </p>

    <div class="animate-fade-up delay-3 flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <a
        href="/builder"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-base font-semibold bg-[var(--color-primary)] text-[var(--color-primary-fg)] hover:bg-[var(--color-primary-hover)] transition-colors shadow-lg shadow-[var(--color-primary)]/20"
      >
        Build an assertion
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
      </a>
      <a
        href="#api"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-base font-semibold border border-[var(--color-ink-3)]/30 hover:border-[var(--color-bp-400)] hover:bg-[var(--color-bp-500)]/5 transition-all"
      >
        API Reference
      </a>
    </div>

    <div class="animate-fade-up delay-4 flex flex-col items-center justify-center gap-3">
      <a
        href={`https://etherscan.io/address/${address}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 px-5 py-3 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15 hover:border-[var(--color-bp-400)]/50 transition-all"
      >
        <span class="text-sm text-[var(--color-ink-3)]">Assertions v1.1</span>
        <code class="font-mono text-sm text-[var(--color-ink-2)] group-hover:text-[var(--color-bp-400)] transition-colors"><span class="sm:hidden">{short(address)}</span><span class="hidden sm:inline">{address}</span></code>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ink-3)]"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
      </a>
      <a
        href={`https://etherscan.io/address/${combinators}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 px-5 py-3 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15 hover:border-[var(--color-bp-400)]/50 transition-all"
      >
        <span class="text-sm text-[var(--color-ink-3)]">Combinators v1.0</span>
        <code class="font-mono text-sm text-[var(--color-ink-2)] group-hover:text-[var(--color-bp-400)] transition-colors"><span class="sm:hidden">{short(combinators)}</span><span class="hidden sm:inline">{combinators}</span></code>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-ink-3)]"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
      </a>
    </div>
  </div>
</section>
