+    predicate IsBytecode(opcode: u8) { opcode in bytecodes }
+  }
+
+  // ===================================================================
+  // Lemmas
+  // ===================================================================
+
+  lemma EipSet(eips: seq<nat>, codes: set<u8>)
+    ensures EipBytecodes(eips,codes) == codes
