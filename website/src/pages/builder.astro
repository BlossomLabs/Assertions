---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AssertionBuilder from '../components/builder/AssertionBuilder';
import BuilderSkeleton from '../components/builder/BuilderSkeleton.astro';
import ContractIcon from '../components/ContractIcon.astro';
---

<Layout
  title="Build an Assertion | assertions.eth"
  description="Compose a transaction batch, simulate it on a fork, let AI suggest protective on-chain assertions, and ship it as a wallet batch, Safe transaction, Governor proposal or Aragon OSx proposal."
>
  <Nav />
  <main class="pt-28 pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <header class="mb-10 animate-fade-up">
        <p class="flex items-center gap-2 font-mono text-sm text-[var(--color-bp-300)] mb-2">
          <ContractIcon name="builder" class="size-4" weight={1.6} />
          Assertion Builder
          <button
            type="button"
            id="beta-chip"
            popovertarget="beta-note"
            aria-label="Beta: what that means"
            class="font-mono text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded border border-[var(--color-bp-400)]/40 text-[var(--color-bp-300)] hover:border-[var(--color-bp-400)] hover:bg-[var(--color-bp-500)]/15 transition-colors cursor-pointer"
          >
            beta
          </button>
        </p>
        <div
          id="beta-note"
          popover
          class="m-0 w-80 max-w-[calc(100vw-2rem)] p-4 rounded-[10px] border border-[var(--color-ink-3)]/25 bg-[var(--color-surface-2)] text-[var(--color-ink)] text-sm leading-relaxed shadow-[0_8px_24px_rgba(8,13,24,0.25)]"
        >
          <p class="font-semibold mb-1.5">The builder is in beta</p>
          <p class="text-[var(--color-ink-2)]">
            The v2.0 contracts are final. The Assertion Builder is still under
            active development, so expect changes and fixes. If something does
            not work as you expect, please report it with the Support button
            at the bottom right of the page.
          </p>
        </div>
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">
          Build an Assertion
        </h1>
        <p class="text-[var(--color-ink-2)] max-w-2xl leading-relaxed">
          Compose a transaction batch from any contract, simulate it on a fork,
          and let AI insert on-chain assertions that make the whole thing revert
          if the chain isn't in the state you expect. Execute it from your
          wallet, a Safe, a Governor or an Aragon OSx DAO.
        </p>
      </header>
      {/* The builder arrives with its scripts: hold its place meanwhile, so
          the footer does not sit under the heading and then jump away. */}
      <div class="animate-fade-up delay-1 min-h-[70vh]">
        <AssertionBuilder client:only="react">
          <BuilderSkeleton slot="fallback" />
        </AssertionBuilder>
      </div>
    </div>
  </main>
  <script>
    // The note opens just under its chip, kept inside the viewport.
    const chip = document.getElementById("beta-chip");
    const note = document.getElementById("beta-note");
    note?.addEventListener("beforetoggle", (event) => {
      if (!chip || (event as ToggleEvent).newState !== "open") return;
      const box = chip.getBoundingClientRect();
      const width = Math.min(320, window.innerWidth - 32);
      const left = Math.max(16, Math.min(box.left, window.innerWidth - width - 16));
      note.style.top = `${box.bottom + 8}px`;
      note.style.left = `${left}px`;
    });
  </script>
  <Footer />
</Layout>
