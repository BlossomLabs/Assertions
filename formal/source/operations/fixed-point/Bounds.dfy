include "Model.dfy"
module OperationsFixedPointBounds {
  import B = OperationsBinaryLogModel
  import M = OperationsFixedPointModel
  lemma Powers()
    ensures B.Power(78) == 302231454903657293676544
    ensures B.Power(96) == M.Q96
    ensures B.Power(159) == 730750818665451459101842416358141509827966271488
    ensures B.Power(174) == 23945242826029513411849172299223580994042798784118784
    ensures B.Power(255) == M.Half
  {
    B.KnownPowers(); B.PowerAdd(8,4); B.PowerAdd(12,2);
    B.PowerAdd(64,14); B.PowerAdd(64,32); B.PowerAdd(128,32); B.PowerAdd(160,14);
    assert B.Power(160) == 2*B.Power(159);
    assert B.Power(256) == 2*B.Power(255);
  }
  lemma Identity(x: int)
    requires M.Signed(x)
    ensures M.S(x) == x
  {
    if x < 0 {
      assert 0 <= x+B.Word < B.Word;
      assert x%B.Word == x+B.Word;
    }
  }
  lemma Residue(x: int)
    ensures M.U(M.S(x)) == M.U(x)
    ensures M.S(M.S(x)) == M.S(x)
    ensures M.S(M.U(x)) == M.S(x)
    ensures M.U(M.U(x)) == M.U(x)
  { Identity(M.S(x)); }
  lemma SignedShift(a: int,n: nat)
    requires M.Signed(a)
    ensures M.Signed(M.Sar(a,n))
  {
    if n < 256 {
      var d := B.Power(n);
      assert a == (a/d)*d+a%d;
      if a/d >= M.Half { B.ProductMonotone(M.Half as nat,(a/d) as nat,d); }
      if a/d < -M.Half {
        assert a/d+1 <= -M.Half;
        assert a < (a/d+1)*d;
        B.ProductMonotone(1,d,M.Half as nat);
      }
    }
  }
  lemma TruncRemainder(a: int,b: int)
    requires b > 0
    ensures -b < a-M.Trunc(a,b)*b < b
  {
    if a < 0 {
      assert -a == ((-a)/b)*b+(-a)%b;
      assert a-M.Trunc(a,b)*b == -((-a)%b);
    } else { assert a == (a/b)*b+a%b; }
  }
  lemma ReducedRange(z: int)
    requires -100000000000000000000000000000000 <= z <= 100000000000000000000000000000000
    ensures -M.Ln2 <= M.ExpReduction(z,M.ExpExponent(z)) <= M.Ln2
  {
    Powers();
    Identity(z*M.Q96);
    var a := z*M.Q96;
    var t := M.Trunc(a,M.Ln2);
    TruncRemainder(a,M.Ln2);
    var rest := a-t*M.Ln2;
    assert -200000000000000000000000000000000 <= t <= 200000000000000000000000000000000;
    Identity(t+M.Q96/2);
    var k := (t+M.Q96/2)/M.Q96;
    assert M.ExpExponent(z) == k;
    assert t+M.Q96/2 == k*M.Q96+(t+M.Q96/2)%M.Q96;
    assert -M.Q96/2 <= t-k*M.Q96 < M.Q96/2;
    assert -3000 <= k <= 3000;
    Identity(k*M.Ln2);
    Identity(z-k*M.Ln2);
    var reduced := z-k*M.Ln2;
    assert reduced*M.Q96 == (t-k*M.Q96)*M.Ln2+rest;
    assert -M.Ln2*M.Q96 <= reduced*M.Q96 <= M.Ln2*M.Q96;
  }
  lemma ScaledRange(x: int)
    requires M.ExpLower < x < M.ExpUpper
    ensures -100000000000000000000000000000000 <= M.ExpScale(x) <= 100000000000000000000000000000000
  {
    Powers(); Identity(x*B.Power(78));
    var scaled := M.Trunc(x*B.Power(78),3814697265625);
    TruncRemainder(x*B.Power(78),3814697265625);
    assert -100000000000000000000000000000000 <= scaled <= 100000000000000000000000000000000;
    Identity(scaled);
  }
  lemma Monotone(a: int,b: int,c: int)
    requires a <= b && c >= 0
    ensures a*c <= b*c
  { B.ProductNonnegative((b-a) as nat,c as nat); assert (b-a)*c == b*c-a*c; }
  lemma ProductRange(a: int,b: int,alo: int,ahi: int,blo: int,bhi: int,lo: int,hi: int)
    requires alo <= a <= ahi && blo <= b <= bhi
    requires lo <= alo*blo <= hi && lo <= alo*bhi <= hi
    requires lo <= ahi*blo <= hi && lo <= ahi*bhi <= hi
    ensures lo <= a*b <= hi
  {
    if b >= 0 { Monotone(alo,a,b); Monotone(a,ahi,b); }
    else { Monotone(alo,a,-b); Monotone(a,ahi,-b); }
    if alo >= 0 { Monotone(blo,b,alo); Monotone(b,bhi,alo); }
    else { Monotone(blo,b,-alo); Monotone(b,bhi,-alo); }
    if ahi >= 0 { Monotone(blo,b,ahi); Monotone(b,bhi,ahi); }
    else { Monotone(blo,b,-ahi); Monotone(b,bhi,-ahi); }
  }
  lemma DivideMonotone(a: int,b: int,d: int)
    requires a <= b && d > 0
    ensures a/d <= b/d
  {
    assert a == (a/d)*d+a%d && b == (b/d)*d+b%d;
    if a/d > b/d {
      Monotone(b/d+1,a/d,d);
      assert (b/d+1)*d == (b/d)*d+d;
      assert (a/d)*d <= a;
      assert b < (b/d+1)*d;
      assert a > b;
    }
  }
  lemma StepBound(x: int,y: int,c: int,xlo: int,xhi: int,ylo: int,yhi: int,plo: int,phi: int,outlo: int,outhi: int)
    requires xlo <= x <= xhi && ylo <= y <= yhi
    requires plo <= xlo*ylo <= phi && plo <= xlo*yhi <= phi
    requires plo <= xhi*ylo <= phi && plo <= xhi*yhi <= phi
    requires -M.Half <= plo && phi < M.Half
    requires plo/M.Q96+c == outlo && phi/M.Q96+c == outhi
    requires -M.Half <= outlo && outhi < M.Half
    ensures outlo <= M.Step(x,y,c) <= outhi
  {
    Powers(); ProductRange(x,y,xlo,xhi,ylo,yhi,plo,phi); Identity(x*y);
    DivideMonotone(plo,x*y,M.Q96); DivideMonotone(x*y,phi,M.Q96);
    Identity((x*y)/M.Q96+c);
  }
  lemma NormalizedRange(x: int,log: nat)
    requires 0 < x < M.Half && log == B.Log(x as nat) && log < 256
    ensures M.Q96 <= M.LnNormalization(x,log) < 2*M.Q96
  {
    Powers(); B.Floor(x as nat);
    if log == 255 { assert B.Power(log) == M.Half; }
    assert log <= 254;
    var shift := 255-log;
    Identity(255-(log as int));
    assert M.U(M.S(255-(log as int))) == shift;
    B.PowerAdd(log,shift); B.PowerAdd(log+1,shift);
    B.ProductMonotone(B.Power(log),x as nat,B.Power(shift));
    B.ProductMonotone((x+1) as nat,B.Power(log+1),B.Power(shift));
    assert B.Power(log)*B.Power(shift) == M.Half;
    assert B.Power(log+1)*B.Power(shift) == B.Word;
    var moved := x*B.Power(shift);
    assert M.Half <= moved;
    assert (x+1)*B.Power(shift) == moved+B.Power(shift);
    assert moved+B.Power(shift) <= B.Word;
    assert moved < B.Word;
    assert M.U(moved) == moved;
    Residue(moved);
    var normalized := moved/B.Power(159);
    B.QuotientUpper(moved as nat,B.Power(159),(2*M.Q96) as nat);
    if normalized < M.Q96 {
      Monotone(normalized+1,M.Q96,B.Power(159));
      assert moved < (normalized+1)*B.Power(159);
    }
    assert M.Q96 <= normalized < 2*M.Q96;
    Identity(normalized);
  }
  lemma ExpDenominatorPositive(x: int)
    requires -54916777467707473351141471128 <= x <= 54916777467707473351141471128
    ensures M.ExpDenominator(x) > 0
  {
    Identity(x-2855989394907223263936484059900);
    var q0 := x-2855989394907223263936484059900;
    assert M.ExpDenominator(x) == M.Horner(x,q0,[50020603652535783019961831881945, -533845033583426703283633433725380, 3604857256930695427073651918091429, -14423608567350463180887372962807573, 26449188498355588339934803723976023]);
    StepBound(x,q0,50020603652535783019961831881945,-54916777467707473351141471128,54916777467707473351141471128,-2910906172374930737287625531028,-2801072617439515790585342588772,-159857586497690202733791255517102200721671485679144130159584,159857586497690202733791255517102200721671485679144130159584,48002917246279557619340581983007,52038290058792008420583081780882);
    var q1 := M.Step(x,q0,50020603652535783019961831881945);
    assert M.ExpDenominator(x) == M.Horner(x,q1,[-533845033583426703283633433725380, 3604857256930695427073651918091429, -14423608567350463180887372962807573, 26449188498355588339934803723976023]);
    StepBound(x,q1,-533845033583426703283633433725380,-54916777467707473351141471128,54916777467707473351141471128,48002917246279557619340581983007,52038290058792008420583081780882,-2857775194958694776726716729348897470975967023272839625374896,2857775194958694776726716729348897470975967023272839625374896,-569915227618839014555410816297578,-497774839548014392011856051153183);
    var q2 := M.Step(x,q1,-533845033583426703283633433725380);
    assert M.ExpDenominator(x) == M.Horner(x,q2,[3604857256930695427073651918091429, -14423608567350463180887372962807573, 26449188498355588339934803723976023]);
    StepBound(x,q2,3604857256930695427073651918091429,-54916777467707473351141471128,54916777467707473351141471128,-569915227618839014555410816297578,-497774839548014392011856051153183,-31297907730601634295187124077851576051902181307528897143327984,31297907730601634295187124077851576051902181307528897143327984,3209822123748517690789966871336162,3999892390112873163357336964846695);
    var q3 := M.Step(x,q2,3604857256930695427073651918091429);
    assert M.ExpDenominator(x) == M.Horner(x,q3,[-14423608567350463180887372962807573, 26449188498355588339934803723976023]);
    StepBound(x,q3,-14423608567350463180887372962807573,-54916777467707473351141471128,54916777467707473351141471128,3209822123748517690789966871336162,3999892390112873163357336964846695,-219661200282605223797529635633645420892118916240417903288721960,219661200282605223797529635633645420892118916240417903288721960,-17196122700100382077783575308165182,-11651094434600544283991170617449965);
    var q4 := M.Step(x,q3,-14423608567350463180887372962807573);
    assert M.ExpDenominator(x) == M.Horner(x,q4,[26449188498355588339934803723976023]);
    StepBound(x,q4,26449188498355588339934803723976023,-54916777467707473351141471128,54916777467707473351141471128,-17196122700100382077783575308165182,-11651094434600544283991170617449965,-944355643628805659680595630006702743413357499109783957907865296,944355643628805659680595630006702743413357499109783957907865296,14529744532218134539712180320226468,38368632464493042140157427127725577);
    var q5 := M.Step(x,q4,26449188498355588339934803723976023);
    assert M.ExpDenominator(x) == M.Horner(x,q5,[]);
