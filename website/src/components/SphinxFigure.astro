<style>
  .sphinx-tail {
    transform-origin: 332px 224px;
    animation: sphinx-tail-sway 5.5s ease-in-out infinite alternate;
  }
  .sphinx-tuft {
    transform-origin: 367px 142px;
    animation: sphinx-tuft-flick 5.5s ease-in-out -0.9s infinite alternate;
  }
  .sphinx-wing {
    transform-origin: 212px 170px;
    animation: sphinx-wing-lift 7s ease-in-out -2s infinite alternate;
  }
  @keyframes sphinx-wing-lift {
    from { transform: rotate(-2deg); }
    to { transform: rotate(3.5deg); }
  }
  .sphinx-head {
    transform-origin: 192px 134px;
    animation: sphinx-head-nod 9s ease-in-out -4s infinite alternate;
  }
  @keyframes sphinx-head-nod {
    from { transform: rotate(-1.2deg); }
    to { transform: rotate(1.6deg); }
  }
  @keyframes sphinx-tail-sway {
    from { transform: rotate(-3deg); }
    to { transform: rotate(5deg); }
  }
  @keyframes sphinx-tuft-flick {
    from { transform: rotate(-12deg); }
    to { transform: rotate(14deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sphinx-head,
    .sphinx-wing,
    .sphinx-tail,
    .sphinx-tuft {
      animation: none;
    }
  }
</style>

<script>
  import '../lib/shy-eyes';
</script>
