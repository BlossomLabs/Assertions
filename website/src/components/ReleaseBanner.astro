</svg>

<script>
  import '../lib/shy-eyes';

  // Eyes marked data-banner-eye are set in motion: the pupil rides a globe
  // behind the lids, follows the pointer while it moves, darts about in
  // saccades whenever it is still, and blinks. Whatever is marked "back" shifts
  // the other way, so the eye sits proud of it. Each eye declares its own
  // geometry in banner units: centre, half width, how far the lid's control
  // point reaches, and the radius of the globe. Without script, or under
  // reduced motion, every eye rests as drawn.
  const MAX_YAW = 1;
  // In half-widths of the eye: within NEAR a window-aimed eye looks straight
  // at the pointer, beyond FAR it only mirrors the pointer's place in the window.
  const NEAR = 1.6;
  const FAR = 4.5;
  const REACTION = 220; // ms between the pointer moving and the eye following
  const BLINK = 220; // ms a blink takes
  const RESTING_AFTER = 350; // ms without movement before the pointer counts as still

  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const eye of reduced ? [] : document.querySelectorAll<SVGGElement>('[data-banner-eye]')) {
    const num = (name: string) => Number(eye.dataset[name] ?? 0);
    const cx = num('cx');
    const cy = num('cy');
    const half = num('half');
    const reach = num('reach');
    const travel = num('travel');
    const maxPitch = num('pitch');
    const lids = eye.querySelectorAll<SVGElement>('[data-eye="lid"]');
    const pupil = eye.querySelector<SVGElement>('[data-eye="pupil"]')!;
    const backs = [...eye.querySelectorAll<SVGElement>('[data-eye="back"]')].map(
      (el) => [el, Number(el.dataset.depth)] as const,
    );

    let yaw = 0;
    let pitch = 0;
    let goalYaw = 0;
    let goalPitch = 0;
    let pointerAt = -Infinity;
    let attending = false;
    let nextSaccade = 600 + Math.random() * 1500;
    let blinkAt = 2000 + Math.random() * 4000;
    let last = 0;
    let frame = 0;

    // What the eye has seen but not yet reacted to.
    const seen: { at: number; yaw: number; pitch: number }[] = [];

    addEventListener(
      'pointermove',
      (e) => {
        // Straight at the pointer: a point on a plane touching the front of
        // the globe, so a pointer over the eye has the pupil directly under it.
        // The last lid is a drawn one; the first sits in a clip path and has no box.
        const box = lids[lids.length - 1].getBoundingClientRect();
        if (!box.width) return;
        const unit = box.width / (half * 2);
        const u = (e.clientX - (box.left + box.width / 2)) / unit;
        const v = (e.clientY - (box.top + box.height / 2)) / unit;
        let yaw = clamp(Math.atan2(u, travel), -MAX_YAW, MAX_YAW);
        let pitch = clamp(Math.asin(-v / Math.hypot(u, v, travel)), -maxPitch, maxPitch);

        // Aimed by the window, a far pointer is mirrored instead: the eye is
        // centred when the pointer is in the middle of the window and hard
        // over at the edges. As the pointer comes close, the eye turns from
        // that to looking straight at it.
        if (eye.dataset.aim === 'window') {
          const far = clamp((Math.hypot(u, v) / half - NEAR) / (FAR - NEAR), 0, 1);
          const blend = far * far * (3 - 2 * far);
          yaw = lerp(yaw, ((e.clientX / innerWidth) * 2 - 1) * MAX_YAW, blend);
          pitch = lerp(pitch, (1 - (e.clientY / innerHeight) * 2) * maxPitch, blend);
        }
        seen.push({ at: performance.now(), yaw, pitch });
      },
      { passive: true },
    );

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      // The eye reacts a beat late: it turns to where the pointer was.
      while (seen.length && now - seen[0].at >= REACTION) {
        const { yaw: y, pitch: p } = seen.shift()!;
        goalYaw = y;
        goalPitch = p;
        pointerAt = now;
        attending = true;
      }

      // It watches the pointer only while the pointer moves. When the pointer
      // rests it loses interest: it blinks, and behind the closed lid turns
      // away to dart about on its own again.
      const resting = now - pointerAt > RESTING_AFTER;
      if (attending && resting) {
        attending = false;
        if (now < blinkAt) blinkAt = now;
        nextSaccade = now + BLINK / 2;
      }
      if (resting && now > nextSaccade) {
        goalYaw = (Math.random() * 2 - 1) * MAX_YAW * 0.85;
        goalPitch = (Math.random() * 2 - 1) * maxPitch * 0.8;
        nextSaccade = now + 250 + Math.random() * Math.random() * 2400;
      }
      const ease = 1 - Math.exp(-dt * 11);
      yaw = lerp(yaw, goalYaw, ease);
      pitch = lerp(pitch, goalPitch, ease);

      let blink = 0;
      if (now > blinkAt) {
        const t = (now - blinkAt) / BLINK;
        if (t >= 1) blinkAt = now + 3000 + Math.random() * 4500;
        else blink = Math.sin(t * Math.PI);
      }

      // The pupil's centre is a point on the globe, and it thins as that
      // point turns away from the viewer.
      const dx = Math.sin(yaw) * Math.cos(pitch);
      const dy = -Math.sin(pitch);
      const dz = Math.cos(yaw) * Math.cos(pitch);
      const x = dx * travel;
      const y = dy * travel;
      const turn = (Math.atan2(dy, dx) * 180) / Math.PI;
      pupil.setAttribute(
        'transform',
        `translate(${(cx + x).toFixed(2)} ${(cy + y).toFixed(2)}) rotate(${turn.toFixed(2)}) scale(${dz.toFixed(4)} 1) rotate(${(-turn).toFixed(2)})`,
      );
      for (const [el, depth] of backs) {
        el.setAttribute('transform', `translate(${(-x * depth).toFixed(2)} ${(-y * depth).toFixed(2)})`);
      }

      // Both lids close on the centre line.
      const r = reach * (1 - blink);
      const almond = `M${cx - half} ${cy} Q${cx} ${(cy - r).toFixed(2)} ${cx + half} ${cy} Q${cx} ${(cy + r).toFixed(2)} ${cx - half} ${cy} Z`;
      for (const lid of lids) lid.setAttribute('d', almond);
    };

    // Only spend frames while the eye is on screen.
    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      if (entry.isIntersecting) {
        last = performance.now();
        frame = requestAnimationFrame(draw);
      }
    }).observe(eye);
  }
</script>
