---
import brandEye from '../assets/brand/assertions-eye.svg';

type Tok = { t: string; c: string };
type Beat = {
  ask: string;
  answer: string;
  detail: string;
  contract: string;
  // A suggested group is what the builder offers after a passing simulation;
  // the rest is what the proposer writes on top.
  groups: { from: string; lines: string[] }[];
};

// One person writes the proposal and signs it: the questions are theirs, and
// the avatar is their ENS avatar, copied locally from the ENS metadata service.
const speaker = { name: 'sem-the-bee.eth', avatar: '/avatars/sem-the-bee.jpg' };

const beats: Beat[] = [
  {
    ask: 'We’re voting to upgrade the vault and hand admin to the council Safe. It executes in seven days. How do I know it lands the way we voted?',
    answer: 'Once the actions run, the council Safe owns the vault.',
    detail: 'The simulation saw the handover and suggested this check. If it fails, the whole proposal reverts.',
    contract: 'Assertions',
    groups: [
      { from: 'Suggested by the vault’s OwnershipTransferred event', lines: ['assert @acl:owner!($vault) == $councilSafe'] },
    ],
  },
  {
    ask: 'The owner’s right. But the vault is a proxy. What code is it actually running?',
    answer: 'The vault points at the new implementation, and that code matches the audited build.',
    detail: 'The simulation suggests the address. Which code is acceptable there is yours to say.',
    contract: 'Operations',
    groups: [
      { from: 'Suggested by the vault’s Upgraded event', lines: ['assert @proxies:implementation!($vault) == $implementation'] },
      { from: 'Added by you', lines: ['assert @codeHash!(@proxies:implementation!($vault)) == 0xdfff…9ca9 "unaudited code"'] },
    ],
  },
  {
    ask: 'We’re handing the keys to a Safe. Who holds its keys?',
    answer: 'Every signer on the council Safe is on the approved list, and at least three must sign.',
    detail: 'The proposal never touches the Safe, so no simulation can suggest this one.',
    contract: 'Collections',
    groups: [
      {
        from: 'Added by you',
        lines: [
          'def @onCouncil! "$o: address -> bool" @includes!($council $o)',
          'assert @all!(@safe:owners!($councilSafe) @onCouncil!) "unknown signer"',
          'assert @safe:threshold!($councilSafe) >= 3 "threshold too low"',
        ],
      },
    ],
  },
];

// A display-only EVML tokenizer: enough classes to read like the builder's
// highlighting, in the site's own palette so both themes follow the tokens.
const TOKEN =
  /(#.*$)|("[^"]*")|\b(assert|def|load|set)\b|(@[\w.:]+!?)|(\$\w+)|(0x[0-9a-fA-F…]+|\b\d+\b)|(::!?|==|>=|<=|!=|->)|(\s+|[^\s"@$#:=<>!-]+|.)/g;
const CLASS = [
  'text-[var(--color-ink-3)]',
  'text-[var(--color-ink-2)]',
  'text-[var(--color-bp-400)] font-semibold',
  'text-[var(--color-bp-400)]',
  'text-[var(--color-ink)]',
  'text-[var(--color-ok)]',
  'text-[var(--color-ok)]',
  'text-[var(--color-ink-2)]',
];
function tokenize(line: string): Tok[] {
  const out: Tok[] = [];
  for (const m of line.matchAll(TOKEN)) {
    const i = m.slice(1).findIndex((g) => g !== undefined);
    out.push({ t: m[0], c: CLASS[i] });
  }
  return out;
}

const rows = beats.map((b) => ({
  ...b,
  groups: b.groups.map((g) => ({ ...g, suggested: g.from.startsWith('Suggested'), code: g.lines.map(tokenize) })),
}));
const assertCount = beats.flatMap((b) => b.groups.flatMap((g) => g.lines)).filter((l) => l.startsWith('assert')).length;
---

<section class="py-24 px-6 scroll-mt-16" id="story" aria-labelledby="story-heading" data-story>
  <div class="max-w-6xl mx-auto">
    <p class="font-mono text-xs uppercase tracking-widest text-[var(--color-bp-400)] mb-3 text-center">
      A DAO proposal upgrades a vault…
    </p>
    <h2 id="story-heading" class="font-mono font-bold text-3xl sm:text-4xl text-center text-balance max-w-2xl mx-auto mb-4">
      What if the vote doesn't land the way it passed?
    </h2>
    <p class="text-center text-[var(--color-ink-2)] text-lg mb-16 max-w-2xl mx-auto">
      We want to upgrade a vault and hand admin to a council Safe. Each
      concern becomes an assertion that runs right after both actions, in the
      same transaction. If any assertion fails, the entire transaction reverts.
    </p>

    <div class="max-w-2xl mx-auto">
      {rows.map((r) => (
        <div class="story-reveal pt-10 first:pt-0" data-reveal>
          <div class="flex items-center justify-end gap-3 mb-2">
            <a href={`https://app.ens.domains/${speaker.name}`} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-[var(--color-ink-3)] hover:text-[var(--color-bp-400)] transition-colors">{speaker.name}</a>
            <img class="story-avatar" src={speaker.avatar} alt="" width="36" height="36" loading="lazy" decoding="async" />
          </div>
          <p class="story-bubble ml-8 sm:ml-16 mr-12 rounded-2xl rounded-tr-sm px-5 py-3.5 leading-relaxed">{r.ask}</p>
          <div class="story-reply mt-5">
            <div class="flex items-center gap-3 mb-2">
              <img src={brandEye.src} class="story-avatar story-logo" width="36" height="36" alt="" loading="lazy" decoding="async" />
              <span class="font-mono text-xs text-[var(--color-ink-3)]">assertions.eth</span>
              <span class="font-mono text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded border border-[var(--color-ink-3)]/30 text-[var(--color-ink-3)]">assistant</span>
            </div>
            <div class="story-answer ml-12 mr-6 sm:mr-12 rounded-2xl rounded-tl-sm px-5 py-4">
              <p class="flex items-start gap-2.5 font-medium leading-snug">
                <span class="text-[var(--color-ok)] shrink-0" aria-hidden="true">&#10003;</span>
                <span>{r.answer}</span>
              </p>
              <p class="mt-1.5 pl-6 text-sm text-[var(--color-ink-2)] leading-relaxed">{r.detail}</p>
              {r.groups.map((g) => (
                <div class="mt-3">
                  <p class={`flex items-center gap-1.5 mb-1.5 font-mono text-[10.5px] uppercase tracking-wider ${g.suggested ? 'text-[var(--color-bp-400)]' : 'text-[var(--color-ink-3)]'}`}>
                    <span aria-hidden="true">{g.suggested ? '✦' : '✎'}</span>
                    {g.from}
                  </p>
                  <div class={`story-code rounded-lg px-3.5 py-2.5 font-mono text-[12.5px] leading-[1.7] ${g.suggested ? 'story-suggested' : ''}`}>
                    {g.code.map((toks) => (
                      <div class="story-line"><code class="story-src block">{toks.map((t) => <span class={t.c}>{t.t}</span>)}</code></div>
                    ))}
                  </div>
                </div>
              ))}
              <p class="mt-3 pl-6">
                <a href="#contracts" class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-[var(--color-bp-400)] hover:underline underline-offset-4">
                  <span class="size-1.5 rounded-full bg-[var(--color-bp-400)]" aria-hidden="true"></span>
                  Answered with {r.contract}
                </a>
              </p>
            </div>
          </div>
        </div>
      ))}

      <p class="mt-10 flex items-center justify-center gap-2 font-mono text-xs text-[var(--color-ink-3)]">
        <span class="text-[var(--color-ok)]">&#9679;</span>
        {assertCount} assertions &middot; appended to the proposal&rsquo;s batch
      </p>
    </div>
  </div>
</section>

<style>
  /* Long lines wrap with a hanging indent instead of scrolling each cell. */
  .story-src {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: 2ch;
    text-indent: -2ch;
  }
  .story-avatar {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 9999px;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--color-bp-400) 30%, transparent);
  }
  .story-logo {
    border: 0;
  }
  .story-bubble {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .story-answer {
    background: var(--color-surface-2);
    border: 1px solid color-mix(in srgb, var(--color-ok) 30%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-ok) 12%, transparent);
  }
  .story-code {
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-ink-3) 15%, transparent);
  }
  .story-suggested {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-bp-400) 45%, transparent);
  }
  .story-code .story-line + .story-line {
    margin-top: 0.15rem;
  }

  /* The reveal only arms once the script runs, so the story reads in full
     without JavaScript and for readers who asked for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    [data-story].is-armed [data-reveal] {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }
    [data-story].is-armed [data-reveal].is-in {
      opacity: 1;
      transform: none;
    }
    [data-story].is-armed .story-reveal .story-reply {
      opacity: 0;
      transition: opacity 0.4s ease-out 0.35s;
    }
    [data-story].is-armed .story-reveal.is-in .story-reply {
      opacity: 1;
    }
  }
</style>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story && 'IntersectionObserver' in window && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    story.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    story.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }
</script>
