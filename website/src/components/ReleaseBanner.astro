      <g transform="translate(900 150)">
        <circle r="84" fill="var(--color-bp-500)" fill-opacity="0.18" />
        <polygon points={hex(62)} fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-width="3" stroke-linejoin="round" />
        <polygon points={hex(34)} fill="none" stroke="var(--color-bp-400)" stroke-width="3" stroke-linejoin="round" />
