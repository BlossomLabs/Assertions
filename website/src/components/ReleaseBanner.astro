      ))}
      <g transform="translate(900 150)">
        <circle r="118" fill="var(--color-surface-2)" />
        <circle r="118" fill="none" stroke="var(--color-bp-400)" stroke-opacity="0.35" stroke-width="2" />
        <circle r="100" fill="var(--color-bp-500)" fill-opacity="0.18" />
        <circle r="80" fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-width="3" />
        <circle r="46" fill="none" stroke="var(--color-bp-400)" stroke-width="3" />
        <path d="M-24 -5 A24 24 0 0 1 24 -5 Z" fill="var(--color-bp-400)" />
        <path d="M-24 5 A24 24 0 0 0 24 5 Z" fill="var(--color-bp-400)" />
