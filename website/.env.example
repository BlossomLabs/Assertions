# Copy to .env. Values prefixed VITE_ are inlined into the static bundle at
# build time and therefore public; scope those keys to the site's domains.

# dRPC key: routes the builder's and deployments table's RPC traffic through
# https://lb.drpc.live for the supported chains. Unset = viem public defaults.
VITE_DRPC_API_KEY=

# Read by @evmcrispr/sdk for ABI lookups.
VITE_ETHERSCAN_API_KEY=

# pnpm deploy:ipfs (server-side only, not bundled).
PINATA_JWT=
