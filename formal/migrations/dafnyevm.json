          "interface": "lemma StructuralRejection(x: Word, c: Constraint, decode: seq<Byte> -> Decoded)\n    requires c.kind == OR && decode(c.data).Leaves?\n    requires |decode(c.data).items| == 0 || (exists leaf <- decode(c.data).items :: leaf.kind == OR)\n    ensures Judge(x,c,decode) == BadOr",
          "fullSha256": "0b45b685991255a5af25fbdaf712d417fcab98dc7fe7d812f3fa0556eab7f5f8"
