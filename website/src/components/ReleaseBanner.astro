---
// One abstract banner per release beast, drawn in the site's own palette.
// Argos: a field of watching eyes. Byakko: a white tiger's stripes behind a
// slit-pupil eye. Cerberos: three half-lidded eyes on a chain.
// Dharmapala: four flame-haloed protectors, each with its own face, rising out of a wall of fire.
// Erinyes: a wing, an eye in a triangle (one corner per Fury), and three
// snakes. Fafnir: a scaled, spiked body leading to a ridged eye. Genbu: a
// tortoise shell of hexagonal plates and a snake wound around a hexagonal eye.
// Haetae: in the centre, one horn and a round eye under a curled brow, with a
// mane of curls on both sides.
// Issitoq: a great eye with a divided pupil, flying over ice under an aurora.
// Janus: a gate on a threshold, and one eye cut in two by it, each half
// looking its own way; the lines that cross the threshold change as they do.
interface Props {
  beast: 'argos' | 'byakko' | 'cerberos' | 'dharmapala' | 'erinyes' | 'fafnir' | 'genbu' | 'haetae' | 'issitoq' | 'janus';
  class?: string;
  /** Omit the filled background so the art can sit over the page. */
  bare?: boolean;
  /** Where a tracking eye looks: straight at the pointer, or at the part of the window the pointer is in. */
  aim?: 'pointer' | 'window';
}
const { beast, class: className = '', bare = false, aim = 'pointer' } = Astro.props;

const W = 1200;
const H = 300;

// Every banner is drawn with its eye on the right. These are mirrored so the
// eye alternates sides from one release to the next: Byakko right, Cerberos
// left, Dharmapala right, Genbu left, Haetae in the centre, Issitoq left,
// Janus right. Erinyes and Fafnir both keep the eye on the right: Erinyes
// reads better unmirrored. Janus is never mirrored: its left side is
// "before" and its right side "after".
const MIRRORED = ['cerberos', 'genbu', 'issitoq'];
const mirror = MIRRORED.includes(beast) ? `translate(${W} 0) scale(-1 1)` : undefined;

// Deterministic pseudo-random so the banner is stable between builds.
const rand = (seed: number) => {
  const x = Math.sin(seed * 9301 + 49297) * 233280;
  return x - Math.floor(x);
};

const eyes: { x: number; y: number; s: number; o: number; look: number; halo: boolean; i: number }[] = [];
// Four eyes, spread over the field, are each set inside three to five rings.
const ARGOS_HALOS = [8, 15, 36, 44];
const ARGOS_RINGS = [4, 3, 5, 3];
if (beast === 'argos') {
  for (let row = 0; row < 5; row++) {
    for (let col = 0; col < 13; col++) {
      const i = row * 13 + col;
      eyes.push({
        x: 50 + col * 92 + (row % 2) * 46 + (rand(i) - 0.5) * 18,
        y: 30 + row * 60 + (rand(i + 99) - 0.5) * 12,
        s: 0.55 + rand(i + 7) * 0.5,
        o: 0.25 + rand(i + 31) * 0.6,
        look: (rand(i + 13) - 0.5) * 10,
        halo: ARGOS_HALOS.includes(i),
        i,
      });
    }
  }
}

const stripes: string[] = [];
if (beast === 'byakko') {
  for (let i = 0; i < 16; i++) {
    const x = -40 + i * 82 + (rand(i) - 0.5) * 24;
    const w = 14 + rand(i + 5) * 16;
    const h = 150 + rand(i + 9) * 150;
    const lean = 70 + rand(i + 3) * 40;
    const y0 = (i % 2) * -30;
    stripes.push(`${x},${y0} ${x + w},${y0} ${x + w + lean * 0.5},${y0 + h * 0.6} ${x + lean},${y0 + h}`);
  }
}

// A chain sagging in from the left: alternate links face on (rings) and edge on (bars).
const links: { x: number; y: number; a: number; ring: boolean }[] = [];
if (beast === 'cerberos') {
  const at = (i: number) => {
    const x = -20 + i * 58;
    const t = x / 720;
    return { x, y: 96 + 110 * Math.sin(Math.PI * Math.min(t, 1) * 0.5) * (1 - 0.45 * t) };
  };
  for (let i = 0; i < 13; i++) {
    const l = at(i);
    const n = i < 12 ? at(i + 1) : { x: l.x + 58, y: l.y };
    links.push({ ...l, a: (Math.atan2(n.y - l.y, n.x - l.x) * 180) / Math.PI, ring: i % 2 === 0 });
  }
}
// The side heads are drawn first so the middle one overlaps them.
const heads = [
  { x: 770, y: 176, s: 0.78, o: 0.6 },
  { x: 1030, y: 176, s: 0.78, o: 0.6 },
  { x: 900, y: 136, s: 1, o: 1 },
];

// Dharmapala's fire: a tongue of flame w wide and h tall, its tip leaning one way.
const flame = (w: number, h: number, lean = 1) =>
  `M${-w} 0 C${-w} ${-h * 0.45} ${-w * 0.1 * lean} ${-h * 0.55} ${w * 0.3 * lean} ${-h} C${w * 0.1 * lean} ${-h * 0.7} ${w} ${-h * 0.45} ${w} 0 Z`;
const fire: { d: string; x: number; o: number }[] = [];
if (beast === 'dharmapala') {
  // Two layers along the whole ground: tall and faint behind, short and denser in front.
  for (const [layer, n, o] of [[0, 22, 0.1], [1, 28, 0.17]]) {
    for (let i = 0; i < n; i++) {
      const k = layer * 40 + i;
      const h = (layer ? 50 : 110) + rand(k + 7) * (layer ? 70 : 120);
      const w = (layer ? 22 : 34) + rand(k + 3) * 14;
      fire.push({ d: flame(w, h, rand(k + 11) > 0.5 ? 1 : -1), x: -10 + i * (1220 / n) + (rand(k) - 0.5) * 20, o });
    }
  }
}
// Four protectors rising out of the fire, each with its own face, growing toward the right.
const spirits = [
  { face: 'upright', x: 200, y: 168, k: 0.56, o: 0.55 },
  { face: 'narrow', x: 420, y: 150, k: 0.68, o: 0.7 },
  { face: 'glaring', x: 670, y: 158, k: 0.82, o: 0.85 },
  { face: 'fanged', x: 950, y: 150, k: 1, o: 1 },
];
// The upright third eye, drawn at scale k so its stroke stays 3 wide.
const THIRD = 'M0 -56 Q40 0 0 56 Q-40 0 0 -56 Z';

// The dragon's body: a band of scales around a wavy spine, thicker toward the head.
const scales: { d: string; o: number; fill: boolean }[] = [];
const spikes: { x: number; y: number; a: number; h: number }[] = [];
if (beast === 'fafnir') {
  const spine = (x: number) => 160 + 44 * Math.sin(x / 150 + 0.6);
  const half = (x: number) => 30 + 46 * Math.min(1, Math.max(0, x + 40) / 620);
  let k = 0;
  for (let row = 0; row < 12; row++) {
    for (let col = 0; col < 40; col++) {
      const x = col * 34 + (row % 2) * 17 - 20;
      const y = row * 26 + 4;
      k++;
      // Stop short of the eye's rings.
      if (x > 900 || Math.hypot(x - 900, y - 150) < 136) continue;
      if (Math.abs(y - spine(x)) > half(x)) continue;
      const fill = rand(k + 50) > 0.72;
      scales.push({ d: `M${x - 17} ${y} A17 17 0 0 0 ${x + 17} ${y}${fill ? ' Z' : ''}`, o: 0.16 + rand(k) * 0.3, fill });
    }
  }
  for (let x = 10; x < 760; x += 46) {
    const slope = (Math.cos(x / 150 + 0.6) * 44) / 150;
    spikes.push({ x, y: spine(x) - half(x) - 6, a: (Math.atan(slope) * 180) / Math.PI, h: 14 + 16 * Math.min(1, x / 620) });
  }
}

// The Fury's wing: three tiers of feathers hanging from a leading edge that
// sweeps left from the shoulder, longest at the tip. Snakes: one per Fury.
const feathers: { d: string; t: string; o: number }[] = [];
let wingEdge = '';
const snakes: string[] = [];
if (beast === 'erinyes') {
  const edge = (t: number) => ({ x: 792 - 770 * t, y: 96 - 70 * Math.sin(Math.PI * t * 0.85) + 40 * t * t });
  const tiers = [
    { n: 24, l0: 90, l1: 250, w: 15, o: 0.2 },
    { n: 20, l0: 60, l1: 130, w: 13, o: 0.3 },
    { n: 16, l0: 34, l1: 62, w: 11, o: 0.42 },
  ];
  for (const t of tiers) {
    for (let i = 0; i < t.n; i++) {
      const u = (i + 0.5) / t.n;
      const p = edge(u);
      const L = t.l0 + (t.l1 - t.l0) * Math.pow(u, 0.7);
      feathers.push({
        d: `M0 ${-t.w} L${L - t.w} ${-t.w} A${t.w} ${t.w} 0 0 1 ${L - t.w} ${t.w} L0 ${t.w * 0.4} Z`,
        t: `translate(${p.x} ${p.y}) rotate(${84 + 62 * Math.pow(u, 0.8)})`,
        o: t.o,
      });
    }
  }
  for (let i = 0; i <= 40; i++) {
    const p = edge(i / 40);
    wingEdge += `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${(p.y - 4).toFixed(1)} `;
  }
  for (const i of [0, 1, 2]) {
    const x0 = i === 1 ? 1024 : 1012;
    const y0 = 150 + (i - 1) * 40;
    let d = '';
    for (let j = 0; j <= 48; j++) {
      const y = y0 + (i - 1) * j * 0.55 + 11 * Math.sin(j / 4.2 + i * 2.1) * Math.min(1, j / 8);
      d += `${j ? 'L' : 'M'}${x0 + j * 4} ${y.toFixed(1)} `;
    }
    snakes.push(d);
  }
}

// Genbu: the tortoise's shell as a dome of hexagonal plates, and the snake
// that crosses it and winds once around the eye.
const hex = (r: number) =>
  Array.from({ length: 6 }, (_, i) => `${(r * Math.cos((i * Math.PI) / 3)).toFixed(1)},${(r * Math.sin((i * Math.PI) / 3)).toFixed(1)}`).join(' ');
const SHELL = { cx: 400, rx: 390, ry: 262, plate: 30 };
const plates: { x: number; y: number; o: number; fill: boolean }[] = [];
let snake = '';
let snakeHead = '';
if (beast === 'genbu') {
  const R = SHELL.plate;
  let k = 0;
  for (let col = -1; col < 20; col++) {
    for (let row = 0; row < 8; row++) {
      const x = col * R * 1.5 + 10;
      const y = row * R * Math.sqrt(3) + (col % 2 ? (R * Math.sqrt(3)) / 2 : 0) + 20;
      k++;
      if (((x - SHELL.cx) / (SHELL.rx - 24)) ** 2 + ((H + 10 - y) / (SHELL.ry - 14)) ** 2 > 1) continue;
      plates.push({ x, y, o: 0.16 + rand(k) * 0.3, fill: rand(k + 50) > 0.7 });
    }
  }
  for (let x = -10; x <= 700; x += 10) snake += `${x > -10 ? 'L' : 'M'}${x} ${(70 + 0.12 * x + 24 * Math.sin(x / 70)).toFixed(1)} `;
  // Join the eye's ring where the snake is heading down and right, then go round it.
  const on = (deg: number) => [900 + 118 * Math.cos((deg * Math.PI) / 180), 150 + 118 * Math.sin((deg * Math.PI) / 180)];
  const [jx, jy] = on(135);
  const [ex, ey] = on(210);
  snake += `C750 132 ${(jx - 36).toFixed(1)} ${(jy - 36).toFixed(1)} ${jx.toFixed(1)} ${jy.toFixed(1)} A118 118 0 1 0 ${ex.toFixed(1)} ${ey.toFixed(1)}`;
  snakeHead = `translate(${ex.toFixed(1)} ${ey.toFixed(1)}) rotate(120)`;
}

// Haetae: a curl is a spiral winding in to its centre, R wide, `turns` times round.
const curl = (R: number, turns = 2.1, dir = 1) => {
  let d = '';
  const n = Math.round(turns * 24);
  for (let i = 0; i <= n; i++) {
    const t = i / n;
    const a = dir * t * turns * 2 * Math.PI;
    const r = R * (1 - t * 0.92);
    d += `${i ? 'L' : 'M'}${(r * Math.cos(a)).toFixed(1)} ${(r * Math.sin(a)).toFixed(1)} `;
  }
  return d;
};
// The mane: rows of curls on both sides of the head, larger and stronger toward it.
const HAETAE_X = 600;
const mane: { d: string; t: string; o: number; w: number }[] = [];
if (beast === 'haetae') {
  let k = 0;
  for (const side of [-1, 1]) {
    for (let row = 0; row < 4; row++) {
      for (let col = 0; col < 9; col++) {
        k++;
        const u = 1 - col / 8;
        const x = HAETAE_X + side * (150 + col * 60 + (row % 2) * 30 + (rand(k + 3) - 0.5) * 14);
        const y = 52 + row * 66 + (rand(k + 9) - 0.5) * 16;
        mane.push({
          d: curl(14 + 28 * u + rand(k) * 6, 2.1, side * ((row + col) % 2 ? 1 : -1)),
          t: `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${Math.round(rand(k + 7) * 360)})`,
          o: (0.1 + 0.32 * u) * (0.7 + rand(k + 5) * 0.5),
          w: 3 + 2.5 * u,
        });
      }
    }
  }
}

// Issitoq: aurora curtains of hanging strokes, two ranges of ice, and the
// streaks the eye leaves behind as it flies.
const aurora: { d: string; o: number }[] = [];
const ice: { d: string; o: number }[] = [];
const streaks: { d: string; o: number; dash: string }[] = [];
if (beast === 'issitoq') {
  for (const [r, y0, amp, o] of [[0, 46, 22, 0.2], [1, 92, 30, 0.13]]) {
    for (let x = 6; x < W; x += 9) {
      if (Math.abs(x - 900) < 132) continue;
      const y = y0 + amp * Math.sin(x / 92 + r * 1.7) + 9 * Math.sin(x / 31 + r);
      const len = 34 + 30 * (0.5 + 0.5 * Math.sin(x / 57 + r * 2.3)) + rand(x + r * 500) * 16;
      aurora.push({ d: `M${x} ${y.toFixed(1)} v${len.toFixed(1)}`, o: o * (0.55 + rand(x + r * 77) * 0.6) });
    }
  }
  for (const [r, base, hgt, o] of [[0, 248, 64, 0.13], [1, 268, 40, 0.22]]) {
    let d = `M0 ${H} `;
    for (let i = 0; i <= 30; i++) {
      const x = i * 40 + (rand(i + r * 60) - 0.5) * 22;
      const peak = i % 2 ? hgt * (0.35 + rand(i * 3 + r * 91) * 0.65) : rand(i + r * 13) * 10;
      d += `L${x.toFixed(1)} ${(base - peak).toFixed(1)} `;
    }
    ice.push({ d: `${d}L${W} ${H} Z`, o });
  }
  for (let i = 0; i < 9; i++) {
    const y = 150 + (i - 4) * 19;
    const edge = 1 - Math.abs(i - 4) / 5;
    const x1 = 900 - Math.sqrt(118 * 118 - (y - 150) ** 2) - 12;
    const len = 90 + 260 * edge * (0.6 + rand(i + 20) * 0.5);
    streaks.push({
      d: `M${x1.toFixed(1)} ${y} h${(-len).toFixed(1)}`,
      o: 0.18 + 0.2 * edge,
      dash: `${(len * 0.55).toFixed(0)} 14 ${(len * 0.2).toFixed(0)} 14 6 14`,
    });
  }
}

// Janus: strata that cross a threshold at x = 900, dashed and faint before
// it, solid and shifted after it, stopping short of the gate on each side.
const THRESHOLD = 900;
const strata: { y: number; o: number; dash: string }[] = [];
if (beast === 'janus') {
  for (let i = 0; i < 9; i++) {
    strata.push({ y: 30 + i * 30, o: 0.16 + rand(i) * 0.22, dash: `${14 + Math.round(rand(i + 9) * 30)} 10` });
  }
}

const labels = {
  argos: 'Argos: a field of watching eyes',
  byakko: 'Byakko: tiger stripes and a slit-pupil eye',
  cerberos: 'Cerberos: three half-lidded eyes held by a chain',
  dharmapala: 'Dharmapala: four flame-haloed protectors rising out of a wall of fire',
  erinyes: 'Erinyes: a wing, an eye in a triangle and three snakes',
  fafnir: 'Fafnir: a scaled, spiked body and a ridged eye',
  genbu: 'Genbu: a tortoise shell and a snake wound around a hexagonal eye',
  haetae: 'Haetae: a mane of curls, a single horn and a round eye under a curled brow',
  issitoq: 'Issitoq: a great eye with a divided pupil, flying over ice under an aurora',
  janus: 'Janus: a gate on a threshold and one eye cut in two, each half looking its own way',
};
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  class={`block w-full h-full ${className}`}
  role="img"
  aria-label={labels[beast]}
>
  {!bare && <rect width={W} height={H} fill="var(--color-surface-2)" />}

  <g transform={mirror}>

  {beast === 'argos' && (
    <g data-shy-field data-shy-half="28" data-shy-upper="-20" data-shy-lower="20">
      {eyes.filter((e) => !e.halo).map((e) => (
        <g transform={`translate(${e.x} ${e.y}) scale(${e.s})`} opacity={e.o}>
          <g data-shy-eye data-doze="3" data-x={e.x} data-y={e.y}>
            <clipPath id={`argos-opening-${e.i}`}><path data-lid d="M-28 0 Q0 -20 28 0 Q0 20 -28 0 Z" /></clipPath>
            <g clip-path={`url(#argos-opening-${e.i})`}>
              <circle cx={e.look} cy="0" r="8" fill="var(--color-bp-400)" />
              <circle cx={e.look} cy="0" r="3" fill="var(--color-surface-2)" />
            </g>
            <path data-lid d="M-28 0 Q0 -20 28 0 Q0 20 -28 0 Z" fill="none" stroke="var(--color-bp-400)" stroke-width="2.4" stroke-linejoin="round" />
          </g>
        </g>
      ))}
      <!-- the ringed eyes: the same blue as the rest, at full strength, each inside three to five rings that fade outward, the white of the eye filled with the shared tint -->
      {eyes.filter((e) => e.halo).map((e) => (
        <g transform={`translate(${e.x} ${e.y})`}>
          {Array.from({ length: ARGOS_RINGS[ARGOS_HALOS.indexOf(e.i)] }, (_, k) => (
            <circle r={32 + k * 11} fill="none" stroke="var(--color-bp-400)" stroke-opacity={0.6 - k * 0.11} stroke-width="1.5" />
          ))}
          <g transform="scale(0.85)">
            <g data-shy-eye data-doze data-x={e.x} data-y={e.y}>
              <clipPath id={`argos-opening-${e.i}`}><path data-lid d="M-28 0 Q0 -20 28 0 Q0 20 -28 0 Z" /></clipPath>
              <path data-lid d="M-28 0 Q0 -20 28 0 Q0 20 -28 0 Z" fill="var(--color-surface-2)" />
              <g clip-path={`url(#argos-opening-${e.i})`}>
                <circle cx={e.look} cy="0" r="8" fill="var(--color-bp-400)" />
                <circle cx={e.look} cy="0" r="3" fill="var(--color-surface-2)" />
              </g>
              <path data-lid d="M-28 0 Q0 -20 28 0 Q0 20 -28 0 Z" fill="var(--color-bp-500)" fill-opacity="0.18" stroke="var(--color-bp-400)" stroke-width="2.6" stroke-linejoin="round" />
            </g>
          </g>
        </g>
      ))}
    </g>
  )}

  {beast === 'byakko' && (
    <g data-banner-eye data-aim={aim} data-cx="900" data-cy="150" data-half="90" data-reach="58" data-travel="62" data-pitch="0.3">
      <circle data-eye="back" data-depth="0.2" cx="900" cy="150" r="118" fill="none" stroke="var(--color-bp-400)" stroke-opacity="0.35" stroke-width="2" />
      <circle data-eye="back" data-depth="0.1" cx="900" cy="150" r="84" fill="var(--color-bp-500)" fill-opacity="0.18" />
      {stripes.map((p) => (
        <polygon points={p} fill="var(--color-bp-400)" fill-opacity="0.22" />
      ))}
      <clipPath id="byakko-opening"><path data-eye="lid" d="M810 150 Q900 92 990 150 Q900 208 810 150 Z" /></clipPath>
      <path data-eye="lid" d="M810 150 Q900 92 990 150 Q900 208 810 150 Z" fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-width="3" />
      <g clip-path="url(#byakko-opening)">
        <g data-eye="pupil" transform="translate(900 150)">
          <ellipse rx="9" ry="44" fill="var(--color-bp-400)" />
        </g>
      </g>
    </g>
  )}

  {beast === 'cerberos' && (
    <g>
      {links.map((l) =>
        l.ring ? (
          <ellipse cx={l.x} cy={l.y} rx="38" ry="17" transform={`rotate(${l.a} ${l.x} ${l.y})`} fill="none" stroke="var(--color-bp-400)" stroke-opacity="0.3" stroke-width="7" />
        ) : (
          <rect x={l.x - 34} y={l.y - 4} width="68" height="8" rx="4" transform={`rotate(${l.a} ${l.x} ${l.y})`} fill="var(--color-bp-400)" fill-opacity="0.3" />
        )
      )}
      {heads.map((h) => (
        <g transform={`translate(${h.x} ${h.y}) scale(${h.s})`}>
          <circle r="118" fill="none" stroke="var(--color-bp-400)" stroke-opacity={0.35 * h.o} stroke-width="2" />
          <circle r="84" fill="var(--color-bp-500)" fill-opacity="0.18" />
          <path d="M-62 -14 L62 -14 A64 64 0 0 1 -62 -14 Z" fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-opacity={h.o} stroke-width="3" stroke-linejoin="round" />
          <path d="M-30 -14 L30 -14 A32 32 0 0 1 -30 -14 Z" fill="none" stroke="var(--color-bp-400)" stroke-opacity={h.o} stroke-width="3" />
          <path d="M-15 -14 L15 -14 A16 16 0 0 1 -15 -14 Z" fill="var(--color-bp-400)" fill-opacity={h.o} />
          <path d="M-84 -14 L84 -14" stroke="var(--color-bp-400)" stroke-opacity={h.o} stroke-width="7" stroke-linecap="round" />
        </g>
      ))}
    </g>
  )}

  {beast === 'fafnir' && (
    <g>
      {scales.map((s) => (
        <path d={s.d} fill={s.fill ? 'var(--color-bp-400)' : 'none'} fill-opacity="0.18" stroke="var(--color-bp-400)" stroke-opacity={s.o} stroke-width="2" />
      ))}
      {spikes.map((s) => (
        <path d={`M-11 0 L4 ${-s.h} L11 0 Z`} transform={`translate(${s.x} ${s.y}) rotate(${s.a})`} fill="var(--color-bp-400)" fill-opacity="0.3" />
      ))}
      <g transform="translate(900 150)">
        <circle r="118" fill="none" stroke="var(--color-bp-400)" stroke-opacity="0.35" stroke-width="2" />
        <circle r="84" fill="var(--color-bp-500)" fill-opacity="0.18" />
        <path d="M-104 -52 L-30 -66 L96 -30" fill="none" stroke="var(--color-bp-400)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M-92 4 L-22 -36 L92 -6 L22 34 Z" fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-width="3" stroke-linejoin="round" />
        <path d="M0 -30 L11 0 L0 30 L-11 0 Z" fill="var(--color-bp-400)" />
      </g>
    </g>
  )}

