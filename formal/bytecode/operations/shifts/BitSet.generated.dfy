   }}
  lemma SemanticWitness(code: seq<Byte>, state: State, value: Word, size: Word, word: Word, a: Word, b: Word)
    requires Matches(code) && Admitted(value,size,word,a,b) && Good(99,state,value,size,word,a,b)
