---
/**
 * Starlight ThemeProvider override: the docs read the same localStorage
 * `theme` key the main site's ThemeToggle writes, so both stay in sync.
 * The site defaults to dark (matching Layout.astro's inline script).
 */
---

<script is:inline>
  (() => {
    const dark = localStorage.getItem('theme') !== 'light';
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    document.documentElement.classList.toggle('dark', dark);
  })();
</script>
