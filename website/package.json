{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "evmcrispr": {
    "repo": "https://github.com/EVMcrispr/evmcrispr.git",
    "commit": "a27638064a4e23da62cb81fa3954ef6e608a5566"
  },
  "scripts": {
    "prepare:evmcrispr": "node scripts/vendor-evmcrispr.mjs && node scripts/copy-monaco.mjs",
    "dev": "pnpm prepare:evmcrispr && astro dev",
    "build": "pnpm prepare:evmcrispr && astro build",
    "check:integration": "pnpm prepare:evmcrispr && node scripts/check-integration.mjs",
    "test": "vitest run",
    "test:vendor": "node --test scripts/vendor-evmcrispr.test.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "deploy:ipfs": "pnpm build && node scripts/deploy-ipfs.js",
    "sync:artifact": "node scripts/export-deploy-artifact.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/starlight": "^0.41.7",
    "@evmcrispr/core": "^0.11.0",
    "@evmcrispr/editor": "^0.11.0",
    "@evmcrispr/module-aragonosx": "^0.11.0",
    "@evmcrispr/module-governor": "^0.11.0",
    "@evmcrispr/module-safe": "^0.11.0",
    "@evmcrispr/module-sim": "^0.11.0",
    "@evmcrispr/sdk": "^0.11.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "viem": "^2.54.1",
    "wagmi": "^3.6.21"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "dotenv": "^17.4.1",
    "monaco-editor": "0.56.0",
    "pinata": "^2.5.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
