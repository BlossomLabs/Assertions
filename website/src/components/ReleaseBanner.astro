        <circle r="84" fill="var(--color-bp-500)" fill-opacity="0.18" />
        <path d="M-15 -58 Q-8 -98 12 -114 Q10 -84 17 -58 Z" fill="var(--color-bp-400)" stroke="var(--color-bp-400)" stroke-width="3" stroke-linejoin="round" />
        <path d="M-60 -34 Q0 -74 60 -34" fill="none" stroke="var(--color-bp-400)" stroke-width="7" stroke-linecap="round" />
        {[-1, 1].map((m) => (
          <path d={curl(17, 1.4, m)} transform={`translate(${m * 60} -17) rotate(-90)`} fill="none" stroke="var(--color-bp-400)" stroke-width="5" stroke-linecap="round" />
        ))}
        <circle cy="18" r="42" fill="var(--color-surface-2)" stroke="var(--color-bp-400)" stroke-width="3" />
        <circle cy="18" r="24" fill="none" stroke="var(--color-bp-400)" stroke-width="3" />
