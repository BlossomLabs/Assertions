; Bitvector steps normalized by the source-derived Dafny program.
(set-logic QF_BV)
(set-option :timeout 30000)
(declare-const k (_ BitVec 256))
(declare-const w (_ BitVec 256))
(push)
(assert (distinct (bvugt (bvor k w) (_ bv4294967295 256))
                  (or (bvugt k (_ bv4294967295 256)) (bvugt w (_ bv4294967295 256)))))
(check-sat)
(pop)
(push)
(assert (distinct (bvlshr w (bvsub (_ bv256 256) (bvmul (_ bv8 256) (_ bv5 256))))
                  ((_ zero_extend 216) ((_ extract 255 216) w))))
(check-sat)
(pop)
(push)
(assert (distinct (bvlshr w (bvsub (_ bv256 256) (bvmul (_ bv8 256) (_ bv6 256))))
                  ((_ zero_extend 208) ((_ extract 255 208) w))))
(check-sat)
(pop)
