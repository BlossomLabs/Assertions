{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "evmcrispr": {
    "repo": "https://github.com/EVMcrispr/evmcrispr.git",
    "commit": "f065a6b4ec30ffa331611bb123c04be899d9c409"
  },
  "scripts": {
    "prepare:evmcrispr": "node scripts/vendor-evmcrispr.mjs && node scripts/copy-monaco.mjs",
    "dev": "pnpm prepare:evmcrispr && astro dev",
    "build": "pnpm prepare:evmcrispr && astro build",
    "check:integration": "pnpm prepare:evmcrispr && node scripts/check-integration.mjs",
    "check:docs": "pnpm prepare:evmcrispr && node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:vendor": "node --test scripts/vendor-evmcrispr.test.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "deploy:ipfs": "pnpm build && node scripts/deploy-ipfs.js",
    "sync:artifact": "node scripts/export-deploy-artifact.mjs",
    "og:capture": "node scripts/capture-og.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@astrojs/starlight": "^0.42.10",
    "@evmcrispr/core": "^0.11.1",
    "@evmcrispr/editor": "^0.11.1",
    "@evmcrispr/module-aragonosx": "^0.11.1",
    "@evmcrispr/module-governor": "^0.11.1",
    "@evmcrispr/module-safe": "^0.11.1",
    "@evmcrispr/module-sim": "^0.11.1",
    "@evmcrispr/sdk": "^0.11.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "html2canvas-pro": "2.5.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "viem": "^2.57.17",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "dotenv": "^18.0.10",
    "jsdom": "^30.1.3",
    "monaco-editor": "0.57.0",
    "pinata": "^2.5.6",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.17": ">=3.4.17 <4",
      "fast-uri@<3.1.9": ">=3.1.9 <4",
      "postcss-selector-parser@<6.1.5": ">=6.1.5 <7",
      "source-map-js@<1.2.2": ">=1.2.2 <2",
      "undici@>=8 <8.12.2": ">=8.12.2 <9",
      "vite@>=8 <8.3.3": ">=8.3.3 <9",
      "zod@>=4 <4.6.6": ">=4.6.6 <5"
    }
  }
}
