---
import '../styles/global.css';
import SupportWidget from '../components/support/SupportWidget';
import { DEFAULT_CARD, SITE } from '../../scripts/site.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Site path of a 1200x630 social card for this page. Without one, the page takes the default card. */
  image?: string;
}

const {
  title = 'Assertions: on-chain assertions for safe governance',
  description = 'Verify view function return values and blockchain state atomically in your DAO proposals, Safe transactions, and protocol upgrades.',
  image = DEFAULT_CARD,
} = Astro.props;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Assertions" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={SITE + image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={SITE + image} />
  </head>
  <body class="font-sans antialiased min-h-screen">
    <slot />
    <SupportWidget client:idle />
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </body>
</html>
