---
const cases = [
  {
    title: 'Keep a treasury floor',
    description: 'Require enough native currency or tokens to remain after a payout.',
  },
  {
    title: 'Keep control where it belongs',
    description: 'Check that owners, admins, and role holders still match your policy.',
  },
  {
    title: 'Put prices in bounds',
    description: 'Compare live oracle values against your limits or an allowed deviation.',
  },
  {
    title: 'Verify the upgrade',
    description: 'Read the exposed implementation address and check its runtime code hash.',
  },
  {
    title: 'Set the window',
    description: 'Require a block timestamp inside the execution window you choose.',
  },
  {
    title: 'Watch the whole portfolio',
    description: 'Map balances, fold totals, or require every position to pass a check.',
  },
  {
    title: 'Reuse the expensive read',
    description: 'Reference one resolved value across multiple checks in an expression graph.',
  },
  {
    title: 'Go deeper than a balance',
    description: 'Navigate returned structs, tuples, and arrays to check the field that matters.',
  },
  {
    title: 'Read between the bytes',
    description: 'Check names, match substrings, or pin a bytes payload by its hash.',
  },
];
---

<section class="py-24 px-6" id="use-cases">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-mono font-bold text-3xl sm:text-4xl text-center mb-4">
      What has to be true?
    </h2>
    <p class="text-center text-[var(--color-ink-2)] text-lg mb-16 max-w-2xl mx-auto">
      Start with a simple condition. Compose your way to richer checks.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cases.map((c) => (
        <div class="group relative p-6 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15 hover:border-[var(--color-ink-3)]/30 transition-all">
          <div class="flex items-start gap-4">
            <div class="mt-0.5 size-2.5 rounded-full shrink-0 bg-[var(--color-bp-400)]"></div>
            <div>
              <h3 class="font-mono font-semibold text-sm mb-1.5">{c.title}</h3>
              <p class="text-sm text-[var(--color-ink-2)] leading-relaxed">{c.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
