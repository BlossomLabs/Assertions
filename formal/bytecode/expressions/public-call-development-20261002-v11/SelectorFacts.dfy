  {
    hide G.BitAnd();
    A.WordIdentity(word); Constants(); GuardRange(word); GuardBits(word as bv256);
    NativeBitAnd(word as bv256,115792089210356248756420345214020892766250353992003419616917011526809519390720);
    A.NatEquality((word as bv256)&(115792089210356248756420345214020892766250353992003419616917011526809519390720 as bv256),114868520915462442597141167955500076753242771306388937253322076133114393919488 as bv256);
  }
  lemma OtherWord(word: G.Word)
    requires word < 114868520915462442597141167955500076753242771306388937253322076133114393919488 || 114868520942422389264291807750167091840262401980026081675862648614218004168704 <= word
    ensures G.BitAnd(word,115792089210356248756420345214020892766250353992003419616917011526809519390720) != 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {
    hide G.BitAnd();
    A.WordIdentity(word); Constants(); OtherRange(word); OtherBits(word as bv256);
    NativeBitAnd(word as bv256,115792089210356248756420345214020892766250353992003419616917011526809519390720);
    NatDifferent((word as bv256)&(115792089210356248756420345214020892766250353992003419616917011526809519390720 as bv256),114868520915462442597141167955500076753242771306388937253322076133114393919488 as bv256);
  }
  lemma WordIdempotent(word: G.Word)
    ensures G.BitAnd(G.BitAnd(word,115792089210356248756420345214020892766250353992003419616917011526809519390720),115792089210356248756420345214020892766250353992003419616917011526809519390720) == G.BitAnd(word,115792089210356248756420345214020892766250353992003419616917011526809519390720)
  {
    hide G.BitAnd();
    A.WordIdentity(word); Constants();
    NativeBitAnd(word as bv256,115792089210356248756420345214020892766250353992003419616917011526809519390720);
    var bits := (word as bv256)&(115792089210356248756420345214020892766250353992003419616917011526809519390720 as bv256);
    C.Inverse256(bits);
    TypedBitAnd(G.BitAnd(word,115792089210356248756420345214020892766250353992003419616917011526809519390720),115792089210356248756420345214020892766250353992003419616917011526809519390720,bits,115792089210356248756420345214020892766250353992003419616917011526809519390720);
    Idempotent(word as bv256);
    A.NatEquality(bits & (115792089210356248756420345214020892766250353992003419616917011526809519390720 as bv256),bits);
  }
