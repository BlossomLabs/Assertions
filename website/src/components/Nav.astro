---
import ThemeToggle from './ThemeToggle';
import ContractIcon from './ContractIcon.astro';
---

<nav class="fixed top-0 inset-x-0 z-50 px-6 border-b border-[var(--color-ink-3)]/15 backdrop-blur-lg bg-[var(--color-surface)]/80">
  <div class="max-w-6xl mx-auto h-16 flex items-center justify-between">
    <a href="/" class="flex items-center group" aria-label="assertions.eth home">
      <svg viewBox="36.54 19.17 38.87 38.87" width="32" height="32" class="h-7 sm:h-8 w-auto md:hidden" aria-hidden="true">
        <svg x="36.54" y="19.17" width="38.87" height="38.87" viewBox="0 0 40 40">
          <clipPath id="nav-eye-clip-sm"><rect width="40" height="40" rx="9"/></clipPath>
          <rect width="40" height="40" rx="9" fill="#1e40af"/>
          <g clip-path="url(#nav-eye-clip-sm)">
            <g transform="translate(23.5 26.5) scale(1.3)">
              <path d="M-28 -3 Q0 -29 28 -3" fill="none" stroke="#f7f5f1" stroke-width="2.6" stroke-linecap="round"/>
              <path d="M-25 0 Q0 -19 25 0 Q0 13 -25 0 Z" fill="#f7f5f1"/>
              <circle cx="-3" cy="-2" r="9" fill="#1e40af"/>
              <circle cx="-3" cy="-2" r="4.4" fill="none" stroke="#f7f5f1" stroke-width="2"/>
            </g>
          </g>
        </svg>
      </svg>
      <svg viewBox="36.54 19.17 300.27 38.87" width="247" height="32" class="h-8 w-auto hidden md:block" aria-hidden="true">
        <svg x="36.54" y="19.17" width="38.87" height="38.87" viewBox="0 0 40 40">
          <clipPath id="nav-eye-clip"><rect width="40" height="40" rx="9"/></clipPath>
          <rect width="40" height="40" rx="9" fill="#1e40af"/>
          <g clip-path="url(#nav-eye-clip)">
            <g transform="translate(23.5 26.5) scale(1.3)">
              <path d="M-28 -3 Q0 -29 28 -3" fill="none" stroke="#f7f5f1" stroke-width="2.6" stroke-linecap="round"/>
              <path d="M-25 0 Q0 -19 25 0 Q0 13 -25 0 Z" fill="#f7f5f1"/>
              <circle cx="-3" cy="-2" r="9" fill="#1e40af"/>
              <circle cx="-3" cy="-2" r="4.4" fill="none" stroke="#f7f5f1" stroke-width="2"/>
            </g>
          </g>
        </svg>
        <text
          class="font-mono fill-[#1e40af] dark:fill-[#f7f5f1]"
          font-size="29.5"
          transform="translate(86.41 50.5)"
        ><tspan x="0" y="0">assertions</tspan><tspan x="177" y="0">.</tspan><tspan x="194.7" y="0">eth</tspan></text>
      </svg>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <a
        href="/docs"
        class="inline-flex items-center px-2 sm:px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-ink-2)] hover:text-[var(--color-bp-300)] transition-colors"
      >
        Docs
      </a>
      <a
        href="/releases"
        class="inline-flex items-center px-2 sm:px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-ink-2)] hover:text-[var(--color-bp-300)] transition-colors"
      >
        Releases
      </a>
      <a
        href="/builder"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-[var(--color-primary)] text-[var(--color-primary-fg)] hover:bg-[var(--color-primary-hover)] transition-colors"
      >
        <ContractIcon name="builder" class="size-4" weight={1.8} />
        Assertion Builder
      </a>
      <a
        href="https://github.com/blossomlabs/Assertions"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="size-9 flex items-center justify-center rounded-lg border border-[var(--color-ink-3)]/30 hover:border-[var(--color-bp-400)] hover:bg-[var(--color-bp-500)]/10 transition-all"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</nav>
