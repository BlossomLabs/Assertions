      <path d={snake} fill="none" stroke="var(--color-surface-2)" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />
      <path d={snake} fill="none" stroke="var(--color-bp-400)" stroke-opacity="0.5" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      <g transform={snakeHead}>
        <path d="M-4 -9 L16 -7 L26 0 L16 7 L-4 9 Z" fill="var(--color-bp-400)" stroke="var(--color-bp-400)" stroke-width="4" stroke-linejoin="round" />
        <path d="M28 0 L40 0 M40 0 L46 -5 M40 0 L46 5" fill="none" stroke="var(--color-bp-400)" stroke-width="2.5" stroke-linecap="round" />
