---
// One line icon per contract, keyed like `deployments.json`. Notations has no
// deployment yet; its icon is ready for when it does.
// core: a tick on a shield, the check that guards the batch. operators:
// the four arithmetic signs. collections: three balls piled in a triangle. expressions: a graph whose bottom node is
// shared by two parents. notations: a field notebook, ring-bound, with its
// elastic band. builder (the Assertion Builder, not a contract): three blocks
// laid and a plus where the next one goes.
export type ContractIconName = 'core' | 'operators' | 'collections' | 'expressions' | 'notations' | 'builder';

interface Props {
  name: ContractIconName;
  class?: string;
  /** Line weight in screen pixels: it does not grow with the icon. */
  weight?: number;
}
const { name, class: className = 'size-6', weight = 1.6 } = Astro.props;

const PATHS: Record<ContractIconName, string[]> = {
  core: [
    'M12 3 19 5.5V11c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V5.5L12 3z',
    'm9 12 2.2 2.2 3.8-4.6',
  ],
  operators: [
    'M4.5 7.5h5',
    'M7 5v5',
    'M14.5 7.5h5',
    'm5 14.5 4 4',
    'm9 14.5-4 4',
    'M14.5 15h5',
    'M14.5 18h5',
  ],
  collections: [
    'M12 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z',
    'M7.6 19.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z',
    'M16.4 19.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z',
  ],
  expressions: [
    'M12 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
    'M6 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
    'M18 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
    'M12 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
    'm10.7 6.5-3.4 4',
    'm13.3 6.5 3.4 4',
    'm7.3 13.5 3.4 4',
    'm16.7 13.5-3.4 4',
  ],
  notations: [
    'M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z',
    'M3 7.5h4',
    'M3 12h4',
    'M3 16.5h4',
    'M15.5 3v18',
  ],
  builder: [
    'M4.5 13.5h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z',
    'M14.5 13.5h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z',
    'M4.5 3.5h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z',
    'M17.5 4.5v6',
    'M14.5 7.5h6',
  ],
};
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {PATHS[name].map((d) => <path d={d} vector-effect="non-scaling-stroke" />)}
</svg>
