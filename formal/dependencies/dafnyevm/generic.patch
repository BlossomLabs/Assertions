+      case 3198 => EipSet(eips[1..],codes+{BASEFEE});
+      case 3855 => EipSet(eips[1..],codes+{PUSH0});
+      case 5656 => EipSet(eips[1..],codes+{MCOPY});
+      case _ => EipSet(eips[1..],codes);
     }
+  }
 
