+            var nvm := vm.substate.AccountAccessed(address);
+            // Thread world state through
+            st.Refund(vm.gas - depositcost).Merge(nworld,vm.transient,nvm).Push(address as u256).SetReturnData([])
+      else
+        ERROR(STACK_OVERFLOW)
     }
+  }
 }
