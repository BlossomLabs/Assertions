pragma solidity 0.8.36;

// Standalone real-EVM oracle. This file is outside the production source tree.
contract AbiModelEncodingOracleTest {
    struct Example {
        uint8[2] numbers;
        bytes[] payloads;
    }

    function testNestedTupleFixture() public pure {
        bytes[] memory payloads = new bytes[](2);
        payloads[0] = hex"";
        payloads[1] = hex"ff";
        Example memory value = Example([uint8(1), uint8(2)], payloads);
        bytes memory expected =
            hex"";
        assert(keccak256(abi.encode(value)) == keccak256(expected));
    }
}
