  {}
  lemma OtherBits(bits: bv256)
    requires bits < 114868520915462442597141167955500076753242771306388937253322076133114393919488 || 114868520942422389264291807750167091840262401980026081675862648614218004168704 <= bits
    ensures (bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720) != 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma Idempotent(bits: bv256)
    ensures ((bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720) & 115792089210356248756420345214020892766250353992003419616917011526809519390720) == (bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720)
