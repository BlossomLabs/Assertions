---
const cards = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Pass the vote. Keep the rules.',
    description: 'Put conditions before and after a proposal’s actions. Require treasury reserves, expected permissions, and the state your DAO voted for.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Sign for the outcome.',
    description: 'Add assertion calls to your Safe batch. Check what arrives, what leaves, and who stays in control, in the same transaction.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Check when it counts.',
    description: 'State can change after a simulation. Assertions check it during execution, so a failed condition reverts the entire batch.',
  },
];
---

<section class="py-24 px-6" id="why">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-mono font-bold text-3xl sm:text-4xl text-center mb-4">
      Your intent, enforced on-chain.
    </h2>
    <p class="text-center text-[var(--color-ink-2)] text-lg mb-16 max-w-2xl mx-auto">
      A <code class="font-mono text-[0.9em]">require</code> checks a value. These
      checks compose: branch lazily, fall back when a source reverts, build a call
      from an address you only learn at execution time.
    </p>
    <div class="grid md:grid-cols-3 gap-6">
      {cards.map((card, i) => (
        <div class={`group relative p-8 rounded-2xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15 hover:border-[var(--color-bp-400)]/40 transition-all duration-300 animate-fade-up delay-${i + 1}`}>
          <div class="size-12 rounded-xl bg-[var(--color-bp-500)]/10 flex items-center justify-center text-[var(--color-bp-400)] mb-5">
            <Fragment set:html={card.icon} />
          </div>
          <h3 class="font-mono font-semibold text-xl mb-3">{card.title}</h3>
          <p class="text-[var(--color-ink-2)] leading-relaxed">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
