{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // @evmcrispr/ai is not published to npm; it resolves to the vendored
    // EVMcrispr checkout (see scripts/vendor-evmcrispr.mjs).
    "paths": {
      "@evmcrispr/ai": ["./.evmcrispr/packages/ai/src/index.ts"]
    }
  }
}