  lemma BelowHeader(bits: bv256)
    requires bits < 114868520915462442597141167955500076753242771306388937253322076133114393919488
    ensures (bits as nat) < 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma AtLeastHeader(bits: bv256)
