        {
          "symbol": "NoAlternativeStep",
          "kind": "lemma",
          "logicalInterface": "lemma NoAlternativeStep(actual: Word, cs: seq<Constraint>, start: nat)\n    requires start < |cs| && (forall c <- cs :: c.kind != OR)\n    requires Leaf(actual,cs[start]) == No\n    ensures Alternatives(actual,cs,start) == Alternatives(actual,cs,start+1)"
        },
        {
          "symbol": "SuccessfulScanStep",
          "kind": "lemma",
          "logicalInterface": "lemma SuccessfulScanStep(cs: seq<Constraint>, data: seq<Byte>, decode: seq<Byte> -> Decoded, start: nat)\n    requires start < |cs| <= |data|/32\n    requires Judge(Read(data[32*start..32*start+32]),cs[start],decode) == Yes\n    ensures Scan(cs,data,decode,start) == Scan(cs,data,decode,start+1)"
        }
      ],
      "acceptance": "No independent source or bytecode acceptance inferred from publication."
