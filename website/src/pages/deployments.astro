---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DeploymentsApp from '../components/deployments/DeploymentsApp';
---

<Layout
  title="Deployments — assertions.eth"
  description="Assertions is deployed at the same address on every chain. See where it lives, and deploy it yourself to any EVM network straight from your wallet."
>
  <Nav />
  <main class="pt-28 pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <header class="mb-10 animate-fade-up">
        <p class="font-mono text-sm text-[var(--color-bp-300)] mb-2">
          Deployments
        </p>
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3">
          One address, every chain
        </h1>
        <p class="text-[var(--color-ink-2)] max-w-2xl leading-relaxed">
          Assertions ships as two contracts — the frozen Assertions core and
          the versionable Combinators building blocks — deployed
          deterministically via CREATE2, so each lives at the same address on
          every EVM network. Anyone can deploy them to a new chain: connect a
          wallet, pick a network, and send one transaction per contract.
        </p>
      </header>
      <div class="animate-fade-up delay-1">
        <DeploymentsApp client:only="react" />
      </div>
    </div>
  </main>
  <Footer />
</Layout>
