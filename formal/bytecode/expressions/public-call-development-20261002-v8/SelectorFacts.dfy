include "Mask.dfy"
module ExpressionsPublicCallSelectorFacts {
  import G = BytecodeGetterMachine
  import A = ExpressionsPublicCallAddressMask
  lemma BelowHeader(bits: bv256)
    requires bits < 114868520915462442597141167955500076753242771306388937253322076133114393919488
    ensures (bits as nat) < 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma AtLeastHeader(bits: bv256)
    requires bits >= 114868520915462442597141167955500076753242771306388937253322076133114393919488
    ensures (bits as nat) >= 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma BelowNext(bits: bv256)
    requires bits < 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures (bits as nat) < 114868520942422389264291807750167091840262401980026081675862648614218004168704
  {}
  lemma AtLeastNext(bits: bv256)
    requires bits >= 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures (bits as nat) >= 114868520942422389264291807750167091840262401980026081675862648614218004168704
  {}
  lemma GuardBits(bits: bv256)
    requires 114868520915462442597141167955500076753242771306388937253322076133114393919488 <= bits < 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures (bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720) == 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma OtherBits(bits: bv256)
    requires bits < 114868520915462442597141167955500076753242771306388937253322076133114393919488 || 114868520942422389264291807750167091840262401980026081675862648614218004168704 <= bits
    ensures (bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720) != 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma Idempotent(bits: bv256)
    ensures ((bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720) & 115792089210356248756420345214020892766250353992003419616917011526809519390720) == (bits & 115792089210356248756420345214020892766250353992003419616917011526809519390720)
  {}
  lemma GuardWord(word: G.Word)
    requires 114868520915462442597141167955500076753242771306388937253322076133114393919488 <= word < 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures G.BitAnd(word,115792089210356248756420345214020892766250353992003419616917011526809519390720) == 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {
    A.WordIdentity(word);
    if (word as bv256) < 114868520915462442597141167955500076753242771306388937253322076133114393919488 { BelowHeader(word as bv256); assert false; }
    if (word as bv256) >= 114868520942422389264291807750167091840262401980026081675862648614218004168704 { AtLeastNext(word as bv256); assert false; }
    GuardBits(word as bv256);
    reveal G.BitAnd();
  }
  lemma OtherWord(word: G.Word)
    requires word < 114868520915462442597141167955500076753242771306388937253322076133114393919488 || 114868520942422389264291807750167091840262401980026081675862648614218004168704 <= word
    ensures G.BitAnd(word,115792089210356248756420345214020892766250353992003419616917011526809519390720) != 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {
    A.WordIdentity(word);
    if word < 114868520915462442597141167955500076753242771306388937253322076133114393919488 {
      if (word as bv256) >= 114868520915462442597141167955500076753242771306388937253322076133114393919488 { AtLeastHeader(word as bv256); assert false; }
    } else {
      if (word as bv256) < 114868520942422389264291807750167091840262401980026081675862648614218004168704 { BelowNext(word as bv256); assert false; }
    }
    OtherBits(word as bv256);
    reveal G.BitAnd();
  }
}
