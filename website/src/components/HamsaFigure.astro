        <circle cx="129.8" cy="580.3" r="5" fill="var(--color-bp-50)" stroke="none" /><circle cx="129.8" cy="580.3" r="2.2" fill="var(--color-bp-400)" stroke="none" />
      </g>
      <g data-hamsa-pendant data-x="200.0" data-y="563.5" data-length="48">
        <circle cx="200.0" cy="567.5" r="4" /><path d="M200.0 571.5 v8" /><circle cx="200.0" cy="588.5" r="9" /><path d="M200.0 597.5 v6 M200.0 603.5 c9 12 7 24 0 26 c-7 -2 -9 -14 0 -26 Z" />
        <circle cx="200.0" cy="588.5" r="5" fill="var(--color-bp-50)" stroke="none" /><circle cx="200.0" cy="588.5" r="2.2" fill="var(--color-bp-400)" stroke="none" />
      </g>
      <g data-hamsa-pendant data-x="270.2" data-y="547.3" data-length="56">
        <circle cx="270.2" cy="551.3" r="4" /><path d="M270.2 555.3 v16" /><circle cx="270.2" cy="580.3" r="9" /><path d="M270.2 589.3 v6 M270.2 595.3 c9 12 7 24 0 26 c-7 -2 -9 -14 0 -26 Z" />
        <circle cx="270.2" cy="580.3" r="5" fill="var(--color-bp-50)" stroke="none" /><circle cx="270.2" cy="580.3" r="2.2" fill="var(--color-bp-400)" stroke="none" />
      </g>
    </g>

    <rect width="400" height="650" fill="var(--color-bp-400)" mask="url(#hamsa-lines)" />

    <!-- the eye in the palm is the logo's, without its lid fold: the white, and a pupil in the line colour
         with a pale ring. The white takes a thin outline so it holds on a light page. This is the resting
         pose; the script below turns the pupil toward the pointer and blinks. -->
    <g transform="translate(200.0 226.4) scale(2.1)" data-hamsa-eye>
      <clipPath id="hamsa-figure-opening"><path data-eye="opening" d="M-25 0 Q0 -19 25 0 Q0 13 -25 0 Z" /></clipPath>
      <path data-eye="rim" d="M-25 0 Q0 -19 25 0 Q0 13 -25 0 Z" fill="var(--color-bp-50)" stroke="var(--color-bp-400)" stroke-width="0.9" stroke-linejoin="round" />
      <g clip-path="url(#hamsa-figure-opening)">
        <g data-eye="iris" transform="translate(0 -2)">
          <circle r="9" fill="var(--color-bp-400)" />
          <circle r="4.4" fill="none" stroke="var(--color-bp-50)" stroke-width="2" />
        </g>
      </g>
    </g>
  </g>
</svg>
<script>
  // The eye follows the pointer the way the logo's eye would: the pupil rides
  // a globe behind the lids and is seen a little edge-on as it turns away, the
  // lids ride with the gaze, and the upper one comes down to blink. Left
  // alone, it looks around. Without script, or under reduced motion, it rests
  // as drawn.
  const TRAVEL = 19; // radius of the globe the pupil rides on, in the eye's own units
  const MAX_YAW = 0.42;
  const MAX_PITCH = 0.22;
  const FOLLOW = 5; // how fast the gaze closes on its target, per second

  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // The charm is a pendulum on its peg, and each pendant a pendulum on the
  // charm: a pendant feels gravity and whatever its pivot does as the hand
  // swings, so the long ones lag and the short ones chatter. A faint, wandering
  // breeze is all that moves the hand.
  // Lengths are in the drawing's own units; GRAVITY is chosen so the hand
  // takes about three and a half seconds to swing over and back.
  const GRAVITY = 1300;
  const HAND_LENGTH = 380; // from the peg to where the hand's weight sits
  const HAND_DRAG = 0.07;
  // The pendants are heavy for their size: their weight sits low, in the drop, so they swing slowly, and
  // the air hardly slows them.
  const PENDANT_HEFT = 1.7;
  const PENDANT_DRAG = 0.22;
  const BREEZE = 0.032;
  const BREEZE_MEMORY = 1.6; // seconds a gust lasts
  const MAX_SWING = 0.1;
  const PEG = { x: 200, y: 5 };
  const STEP = 1 / 120;

  const gauss = () => Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(2 * Math.PI * Math.random());

  for (const hang of document.querySelectorAll<SVGGElement>('[data-hamsa-hang]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) break;

    const pendants = [...hang.querySelectorAll<SVGGElement>('[data-hamsa-pendant]')].map((el) => ({
      el,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      length: Number(el.dataset.length) * PENDANT_HEFT,
      angle: 0, // from straight down, in the page's frame
      speed: 0,
      px: 0,
      py: 0,
      vx: 0,
      vy: 0,
    }));
    // Angles turn the way SVG's rotate does, so a positive one carries the bottom of the charm to the left.
    let angle = 0.04;
    let speed = 0;
    let wind = 0;
    let owed = 0;
    let last = 0;
    let frame = 0;

    const pivot = (p: { x: number; y: number }) => {
      const c = Math.cos(angle);
      const s = Math.sin(angle);
      const x = p.x - PEG.x;
      const y = p.y - PEG.y;
      return [PEG.x + x * c - y * s, PEG.y + x * s + y * c];
    };
    for (const p of pendants) [p.px, p.py] = pivot(p);

    const step = () => {
      wind += (-wind / BREEZE_MEMORY) * STEP + BREEZE * Math.sqrt(STEP) * gauss();
      speed += (-(GRAVITY / HAND_LENGTH) * Math.sin(angle) - HAND_DRAG * speed + wind) * STEP;
      speed = Math.min(1.2, Math.max(-1.2, speed));
      angle += speed * STEP;
      if (Math.abs(angle) > MAX_SWING) {
        angle = Math.sign(angle) * MAX_SWING;
        speed *= -0.3;
      }
      for (const p of pendants) {
        // how the pivot is accelerating, from where the swing has just carried it
        const [x, y] = pivot(p);
        const vx = (x - p.px) / STEP;
        const vy = (y - p.py) / STEP;
        const ax = (vx - p.vx) / STEP;
        const ay = (vy - p.vy) / STEP;
        p.px = x;
        p.py = y;
        p.vx = vx;
        p.vy = vy;
        p.speed +=
          ((ax * Math.cos(p.angle) - (GRAVITY - ay) * Math.sin(p.angle)) / p.length - PENDANT_DRAG * p.speed) * STEP;
        p.angle += p.speed * STEP;
      }
    };

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      owed = Math.min(0.1, owed + (now - last) / 1000);
      last = now;
      for (; owed >= STEP; owed -= STEP) step();
      const deg = (a: number) => ((a * 180) / Math.PI).toFixed(3);
      hang.setAttribute('transform', `rotate(${deg(angle)} ${PEG.x} ${PEG.y})`);
      // a pendant is drawn inside the hand, so it turns by what it has over the hand's own swing
      for (const p of pendants) p.el.setAttribute('transform', `rotate(${deg(p.angle - angle)} ${p.x} ${p.y})`);
    };

    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      if (entry.isIntersecting) {
        last = performance.now();
        frame = requestAnimationFrame(draw);
      }
    }).observe(hang);
  }

  for (const eye of document.querySelectorAll<SVGGElement>('[data-hamsa-eye]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) break;

    const part = (name: string) => eye.querySelector<SVGElement>(`[data-eye="${name}"]`)!;
    const opening = part('opening');
    const rim = part('rim');
    const iris = part('iris');

    let yaw = 0;
    let pitch = 0;
    let goalYaw = 0;
    let goalPitch = 0;
    let pointerAt = -Infinity;
    let nextSaccade = 0;
    let blinkAt = 2200;
    let last = 0;
    let frame = 0;

    addEventListener(
      'pointermove',
      (e) => {
        // The hand swings, so the eye is measured where it is now. Its lids are 50 units wide.
        const box = rim.getBoundingClientRect();
        const unit = box.width / 50 || 1;
        const u = (e.clientX - (box.left + box.width / 2)) / unit;
        const v = (e.clientY - (box.top + box.height / 2)) / unit;
        goalYaw = clamp(Math.atan2(u, TRAVEL), -MAX_YAW, MAX_YAW);
        goalPitch = clamp(Math.asin(-v / Math.hypot(u, v, TRAVEL)), -MAX_PITCH, MAX_PITCH);
        pointerAt = performance.now();
      },
      { passive: true },
    );

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      if (now - pointerAt > 2500 && now > nextSaccade) {
        goalYaw = (Math.random() * 2 - 1) * MAX_YAW * 0.85;
        goalPitch = (Math.random() * 2 - 1) * MAX_PITCH * 0.8;
        nextSaccade = now + 900 + Math.random() * 2200;
      }
      const ease = 1 - Math.exp(-dt * FOLLOW);
      yaw = lerp(yaw, goalYaw, ease);
      pitch = lerp(pitch, goalPitch, ease);

      let blink = 0;
      if (now > blinkAt) {
        const t = (now - blinkAt) / 190;
        if (t >= 1) blinkAt = now + 2600 + Math.random() * 3800;
        else blink = Math.sin(t * Math.PI);
      }

      const dx = Math.sin(yaw) * Math.cos(pitch);
      const dy = -Math.sin(pitch);
      const dz = Math.cos(yaw) * Math.cos(pitch);
      const turn = (Math.atan2(dy, dx) * 180) / Math.PI;
      iris.setAttribute(
        'transform',
        `translate(${(dx * TRAVEL).toFixed(2)} ${(dy * TRAVEL - 2).toFixed(2)}) rotate(${turn.toFixed(2)}) scale(${dz.toFixed(4)} 1) rotate(${(-turn).toFixed(2)})`,
      );

      const up = (pitch / MAX_PITCH) * 0.5;
      const lower = 13 - up * 2;
      const upper = lerp(-19 - up * 4, lower, blink);
      const almond = `M-25 0 Q0 ${upper.toFixed(2)} 25 0 Q0 ${lower.toFixed(2)} -25 0 Z`;
      opening.setAttribute('d', almond);
      rim.setAttribute('d', almond);
    };

    // Only spend frames while the eye is on screen.
    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(frame);
      if (entry.isIntersecting) {
        last = performance.now();
        frame = requestAnimationFrame(draw);
      }
    }).observe(eye);
  }
</script>
