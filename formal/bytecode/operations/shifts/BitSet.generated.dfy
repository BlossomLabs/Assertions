    reveal Matches();
    reveal Step();
    assert state == Running(1309,[2994757980,32,128],Store(Store([],64,128),128,(if (if (if (BitAnd(1,Right(a,b))) == (1) then 1 else 0) == 0 then 1 else 0) == 0 then 1 else 0)));
