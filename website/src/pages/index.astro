---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Story from '../components/Story.astro';
import UseCases from '../components/UseCases.astro';
import Contracts from '../components/Contracts.astro';
import FeaturedTx from '../components/FeaturedTx.astro';
import Limits from '../components/Limits.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Assertions: Set the conditions. Then send it."
  description="Between signing and execution, many things may change. Assertions check what has to be true the moment your transaction runs. If one fails, nothing happens."
>
  <Nav />
  <main>
    <Hero />
    <Story />
    <UseCases />
    <Contracts />
    <FeaturedTx />
    <Limits />
    <Closing />
  </main>
  <Footer />
</Layout>
