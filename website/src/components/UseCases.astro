---
const cases = [
  {
    title: 'Treasury floor',
    question: 'Is there still enough left after this pays out?',
  },
  {
    title: 'Price bounds',
    question: 'Is the oracle price still where it was when we voted?',
  },
  {
    title: 'Execution window',
    question: 'Is this landing inside the window we agreed on?',
  },
  {
    title: 'Total value',
    question: 'Do all our balances, added together, still cover what we owe?',
  },
  {
    title: 'Deep reads',
    question: 'Is the field buried in that struct what we expect?',
  },
  {
    title: 'Bytes and strings',
    question: 'Is this the token we think it is, by name and not just by address?',
  },
];
---

<section class="py-24 px-6" id="use-cases">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-mono font-bold text-3xl sm:text-4xl text-center mb-4">
      What else has to be true?
    </h2>
    <p class="text-center text-[var(--color-ink-2)] text-lg mb-16 max-w-2xl mx-auto">
      Every proposal raises its own questions. Each one becomes a check.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cases.map((c) => (
        <div class="group relative p-6 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15 hover:border-[var(--color-ink-3)]/30 transition-all">
          <div class="flex items-start gap-4">
            <div class="mt-1 size-2.5 rounded-full shrink-0 bg-[var(--color-bp-400)]"></div>
            <div>
              <h3 class="font-mono font-semibold text-xs uppercase tracking-wider text-[var(--color-ink-3)] mb-2">{c.title}</h3>
              <p class="text-[var(--color-ink)] leading-snug">{c.question}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
