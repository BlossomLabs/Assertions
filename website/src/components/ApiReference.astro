---
const sections = [
  {
    title: 'The judge (Assertions core)',
    fns: [
      { name: 'assertParam', desc: 'Assert one ERC-8211 input parameter: resolve its value (raw bytes, staticcall, or balance read) and validate its inline constraints — the 90% case, no batch scaffolding' },
      { name: 'assertComposable', desc: 'Assert an ERC-8211 composable batch under view semantics: entries construct calls by splicing resolved parameters, constraints validate along the way' },
    ],
  },
  {
    title: 'Core reads (Assertions core)',
    fns: [
      { name: 'resolve', desc: 'Resolve one operand and return its bytes — with constraint validation, any expression node becomes an inline assert' },
      { name: 'pick', desc: 'Select a raw 32-byte word from a resolved operand (signed index, negative from the end)' },
      { name: 'nav', desc: 'Typed navigation: interpret a resolved operand as a declared return tuple and walk a path through tuples and dynamic arrays — single words, canonical dynamic envelopes, and decoded lengths (LEN sentinel)' },
      { name: 'chain', desc: 'Follow runtime-resolved addresses: each hop staticcalls the address the previous hop returned' },
      { name: 'read', desc: 'Construct a staticcall at judge time: selector plus runtime-resolved calldata segments against a runtime-resolved target — the composition socket every Operators call (and any view contract) is reached through' },
      { name: 'cond', desc: 'Lazy conditional: resolve the condition, then resolve and return ONLY the winning branch — the losing branch’s calls never happen' },
      { name: 'orElse', desc: 'Composable try/catch: resolve the attempt; on ANY revert (constraints double as guards) resolve the fallback instead' },
      { name: 'isValid', desc: '1 if an operand resolves and passes its constraints, else 0 — assert that a call succeeds, fails, or branch on resolvability' },
      { name: 'revertData', desc: 'The revert data of a call that MUST fail: match an expected error selector, strip it, and navigate the error’s arguments like a return value' },
    ],
  },
  {
    title: 'ERC-8211 wire format (what the judge consumes)',
    fns: [
      { name: 'InputParam', desc: 'One runtime-resolved value: a fetcher (RAW_BYTES literal, STATIC_CALL, or BALANCE — native or ERC-20), inline constraints, and a routing type' },
      { name: 'Constraint', desc: 'An inline predicate on a resolved value: EQ, GTE, LTE, or IN (inclusive bounds) over its first 32-byte word' },
      { name: 'ComposableExecution', desc: 'One batch entry: a function selector plus input parameters whose resolved values are spliced into the constructed call' },
    ],
  },
  {
    title: 'Operators (plain-value vocabulary)',
    fns: [
      { name: 'add … max, exp', desc: 'Checked word arithmetic as named functions — add, sub, mul, div, mod, min, max with int256 overloads for signed semantics, exp unsigned; decoded calldata reads on any explorer' },
      { name: 'absDiff', desc: 'The magnitude |a − b|, unsigned or signed, total even across the widest int256 span — the approximate-equality workhorse' },
      { name: 'eq, ne, lt, gt, le, ge', desc: 'Comparisons returning bool (int256 overloads order negatives correctly); judged EQ 1 through the core' },
      { name: 'bitAnd, bitOr, bitXor, shl, shr, bitSet', desc: 'Bitwise ops and shifts (EVM semantics), plus a one-call bit test for bitmap character classes' },
      { name: 'balance, codehash, timestamp, blockNumber, chainId', desc: 'Environment reads at judge time, as plain argument-free or address-taking calls' },
      { name: 'concat, slice, byteLen, hash', desc: 'Bytes assembly and keccak256 of the decoded payload — an EQ constraint over hash pins any string or bytes value' },
      { name: 'indexOf, wordIndexOf', desc: 'Substring search by signed occurrence ordinal (-1 is the last match) and first-match word search over array payloads; both not-founds compose as length sentinels' },
      { name: 'encode', desc: 'Runtime abi.encode from pre-resolved component values (nav’s inverse) — its raw output is a calldata segment for read splicing' },
      { name: 'foldRange, foldBytes, foldWords', desc: 'Bounded folds over an index range, a byte string, or 32-byte words: a single-staticcall template lambda per element, with Any/All short-circuit — iteration without Turing completeness' },
    ],
  },
];
---

<section class="py-24 px-6" id="api">
  <div class="max-w-4xl mx-auto">
    <h2 class="font-mono font-bold text-3xl sm:text-4xl text-center mb-4">
      API Reference
    </h2>
    <p class="text-center text-[var(--color-ink-2)] text-lg mb-16 max-w-2xl mx-auto">
      Since v2.0, assertions speak <a href="https://www.erc8211.com/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-bp-400)] hover:underline underline-offset-4">ERC-8211</a>: describe the on-chain values to
      fetch (raw bytes, staticcall results, or balances) and the constraints
      they must satisfy. The Assertions core resolves everything live and
      reverts the transaction if any constraint fails, with a custom error
      message if you provide one. The core also owns every read primitive
      (selection, chained lookups, constructed calls, lazy conditionals);
      when a value needs computing, its read splices live operands into the
      plain-typed Operators contract and judges the result. The core reads
      and judges. Operators compute.
    </p>
    <div class="flex flex-col gap-3">
      {sections.map((section) => (
        <details class="group rounded-xl border border-[var(--color-ink-3)]/15 bg-[var(--color-surface-2)] overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer select-none hover:bg-[var(--color-bp-500)]/5 transition-colors">
            <span class="font-mono font-semibold">{section.title}</span>
            <span class="flex items-center gap-2">
              <span class="text-xs text-[var(--color-ink-3)] font-mono">{section.fns.length}</span>
              <svg class="size-4 text-[var(--color-ink-3)] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </span>
          </summary>
          <div class="border-t border-[var(--color-ink-3)]/10">
            <table class="w-full text-sm">
              <tbody>
                {section.fns.map((fn, i) => (
                  <tr class={i > 0 ? 'border-t border-[var(--color-ink-3)]/5' : ''}>
                    <td class="px-6 py-3 font-mono text-[var(--color-bp-400)] whitespace-nowrap">{fn.name}</td>
                    <td class="px-6 py-3 text-[var(--color-ink-2)]">{fn.desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
