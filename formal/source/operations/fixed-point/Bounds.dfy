  lemma LnDenominatorPositive(x: int)
    requires 79228162514264337593543950336 <= x <= 158456325028528675187087900671
    ensures M.LnDenominator(x) > 0
  {
    Identity(x+5573035233440673466300451813936);
    var q0 := x+5573035233440673466300451813936;
    assert M.LnDenominator(x) == M.Horner(x,q0,[71694874799317883764090561454958, 283447036172924575727196451306956, 401686690394027663651624208769553, 204048457590392012362485061816622, 31853899698501571402653359427138, 909429971244387300277376558375]);
    StepBound(x,q0,71694874799317883764090561454958,79228162514264337593543950336,158456325028528675187087900671,5652263395954937803893995764272,5731491558469202141487539714607,447818442908145448251839043209505885226575096981654331195392,908191089287064258031349665259537155401857174035562103801297,77347138195272821567984557219230,83157857916256288047065640884099);
