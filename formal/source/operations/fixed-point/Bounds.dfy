  lemma ExpCoefficient()
    ensures M.S(M.Shl(4385272521454847904659076985693276,96)) == 347437083999162433888837515002539729507623920905942392673140736
  {
    Powers();
    Identity(347437083999162433888837515002539729507623920905942392673140736);
  }
}
