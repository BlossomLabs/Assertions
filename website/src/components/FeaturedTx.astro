---
// The Jan 29, 2026 transaction in which TheDAO's curator multisig moved
// 71,202 ETH (~$220M) and its remaining DAO tokens in one Safe batch,
// sealed by nine calls to Assertions v1.0 (assertions.eth). Decoded from
// calldata; every line below is verbatim from the multisend.
const TX =
  '0x462475a38cd8a3b75b2732db28ea21a7addfce059af03ea4f638f461c707bf10';

// The ten state-changing calls of the batch.
const moves = [
  { target: 'OldMultisig', fn: 'setDailyLimit', args: 'type(uint256).max' },
  { target: 'OldMultisig', fn: 'send', args: 'SecurityFundSafe, 719.09 ETH' },
  { target: 'ExtraBalance', fn: 'clawback', args: '' },
  { target: 'OldMultisig', fn: 'send', args: 'StakingWithdrawSafe, 69,183.24 ETH' },
  { target: 'OldMultisig', fn: 'send', args: 'ExtraBalance, 1,300 ETH' },
  { target: 'TheDAO', fn: 'transferFrom', args: 'TheDAO, SecurityFundSafe, 2,960.35 DAO' },
  { target: 'TheDAO', fn: 'transfer', args: 'SecurityFundSafe, 387,684.63 DAO' },
  { target: 'TheDAO', fn: 'changeAllowedRecipients', args: 'DGD, true' },
  { target: 'TheDAO', fn: 'changeAllowedRecipients', args: 'SAI, true' },
  { target: 'OldMultisig', fn: 'setDailyLimit', args: '0' },
];

// The nine assertion calls that seal it, all on assertions.eth (v1.0).
const asserts = [
  { fn: 'assertEqBalance', args: 'ExtraBalance, 1300 ether' },
  { fn: 'assertGeBalance', args: 'StakingWithdrawSafe, 69183.23 ether' },
  { fn: 'assertEqBalance', args: 'SecurityFundSafe, 719.08 ether' },
  { fn: 'assertEqBalance', args: 'OldCuratorsSafe, 0' },
  { fn: 'assertEqCallUint', args: 'TheDAO.balanceOf(SecurityFundSafe), 390,644.97 DAO' },
  { fn: 'assertEqCallUint', args: 'TheDAO.balanceOf(TheDAO), 0' },
  { fn: 'assertEqCallUint', args: 'TheDAO.balanceOf(OldMultisig), 0' },
  { fn: 'assertTrue', args: 'TheDAO.allowedRecipients(DGD)' },
  { fn: 'assertTrue', args: 'TheDAO.allowedRecipients(SAI)' },
];

// The same nine guards as a single ERC-8211 batch on Assertions v2.0:
// BALANCE fetchers (token zero = native, else balanceOf) and STATIC_CALL
// fetchers judged by inline EQ/GTE constraints.
const assertsV2 = [
  { fn: 'balance', args: 'ExtraBalance', op: 'EQ', val: '1300 ether' },
  { fn: 'balance', args: 'StakingWithdrawSafe', op: 'GTE', val: '69,183.23 ether' },
  { fn: 'balance', args: 'SecurityFundSafe', op: 'EQ', val: '719.08 ether' },
  { fn: 'balance', args: 'OldCuratorsSafe', op: 'EQ', val: '0' },
  { fn: 'balance', args: 'TheDAO, SecurityFundSafe', op: 'EQ', val: '390,644.97 DAO' },
  { fn: 'balance', args: 'TheDAO, TheDAO', op: 'EQ', val: '0' },
  { fn: 'balance', args: 'TheDAO, OldMultisig', op: 'EQ', val: '0' },
  { fn: 'call', args: 'TheDAO.allowedRecipients(DGD)', op: 'EQ', val: 'true' },
  { fn: 'call', args: 'TheDAO.allowedRecipients(SAI)', op: 'EQ', val: 'true' },
].map((a) => {
  const label = `${a.fn}(${a.args})`;
  return {
    ...a,
    pad: ' '.repeat(Math.max(1, 38 - label.length)),
    opPad: ' '.repeat(4 - a.op.length),
  };
});

const stats = [
  { value: '71,202 ETH', label: 'moved in one batch' },
  { value: '≈$220M', label: 'under guard' },
  { value: '9', label: 'assertions sealing it' },
  { value: '0', label: 'partial outcomes possible' },
];
---

<section class="py-24 px-6" id="featured">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-mono font-bold text-3xl sm:text-4xl text-center mb-4">
      Proven at $220M
    </h2>
    <p class="text-center text-[var(--color-ink-2)] text-lg mb-16 max-w-2xl mx-auto">
      On Jan 29, 2026, TheDAO&rsquo;s curator multisig moved 71,202 ETH in a
      single transaction, and nine assertions decided whether it landed.
    </p>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--color-bp-500)]/30 dark:border-[var(--color-bp-400)]/40 bg-[var(--color-bp-500)]/10 dark:bg-[var(--color-bp-400)]/10 text-[var(--color-bp-400)] text-sm font-mono mb-6">
          Assertions v1.0 &middot; assertions.eth
        </div>

        <p class="text-[var(--color-ink-2)] leading-relaxed mb-4">
          The same multisig that curated TheDAO in 2016 batched ten calls
          through a Safe: 69,183 ETH into the staking vault that now
          endows <a href="https://thedao.fund" target="_blank" rel="noopener noreferrer" class="text-[var(--color-bp-400)] hover:underline underline-offset-4">TheDAO Security Fund</a>,
          1,300 ETH re-funding the ExtraBalance withdraw contract for open
          claims, its last DAO tokens swept, DGD and SAI whitelisted for
          recovery. A decade of dormant history moved in one shot.
        </p>
        <p class="text-[var(--color-ink-2)] leading-relaxed mb-8">
          The batch ends with nine calls to <span class="font-mono text-sm">assertions.eth</span>:
          exact balances at every destination, drained sources, whitelist flags
          set. Had any single check failed, all nineteen calls would have
          reverted together: no partial transfer, nothing to clean up,
          try again tomorrow. On v2.0 the same nine guards fit in a single
          <span class="font-mono text-sm">assertComposable</span> call; flip
          the trace to compare.
        </p>

        <div class="grid grid-cols-2 gap-4 mb-8">
          {stats.map((s) => (
            <div class="p-4 rounded-xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15">
              <div class="font-mono font-bold text-2xl text-[var(--color-bp-400)] mb-1">{s.value}</div>
              <div class="text-sm text-[var(--color-ink-2)]">{s.label}</div>
            </div>
          ))}
        </div>

        <a
          href={`https://etherscan.io/tx/${TX}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 font-mono text-sm text-[var(--color-bp-400)] hover:underline underline-offset-4"
        >
          View the transaction on Etherscan
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
        </a>
      </div>

      <div class="rounded-2xl bg-[var(--color-surface-2)] border border-[var(--color-ink-3)]/15 overflow-hidden shadow-lg shadow-[var(--color-bp-900)]/5">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-ink-3)]/15">
          <span class="size-2.5 rounded-full bg-[var(--color-ink-3)]/30"></span>
          <span class="size-2.5 rounded-full bg-[var(--color-ink-3)]/30"></span>
          <span class="size-2.5 rounded-full bg-[var(--color-ink-3)]/30"></span>
          <span class="ml-2 font-mono text-xs text-[var(--color-ink-3)] truncate">
            Tx {TX.slice(0, 10)}&hellip;{TX.slice(-4)} &middot; decoded
          </span>
          <span class="ftx-select-wrap ml-auto shrink-0">
            <button type="button" class="ftx-select" aria-haspopup="listbox" aria-expanded="false" aria-label="Assertion encoding">
              <span data-ftx-current>v1.0 &middot; as executed</span>
              <svg class="ftx-select-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="ftx-menu" role="listbox" hidden>
              <button type="button" class="ftx-option" role="option" data-ftx-option="v1" aria-selected="true">v1.0 &middot; as executed</button>
              <button type="button" class="ftx-option" role="option" data-ftx-option="v2" aria-selected="false">v2.0 &middot; as written today</button>
            </div>
          </span>
        </div>
        <div class="p-4 sm:p-5 overflow-x-auto font-mono text-[13px] leading-[1.7]">
          <div class="whitespace-nowrap text-[var(--color-ink-3)]">// OldCuratorsSafe (0x47b7&hellip;377D) &rarr; MultiSend, 19 calls</div>
          {moves.map((m) => (
            <div class="whitespace-nowrap"><span class="text-[var(--color-ink-3)]">{m.target}.</span><span class="text-[var(--color-bp-400)]">{m.fn}</span><span class="text-[var(--color-ink-2)]">({m.args})</span></div>
          ))}
          <div data-ftx-panel="v1" class="mt-3">
            <div class="whitespace-nowrap text-[var(--color-ink-3)]">// post-conditions: any failure reverts it all</div>
            {asserts.map((a) => (
              <div class="whitespace-nowrap"><span class="text-[var(--color-ok)]">&#10003;&nbsp;</span><span class="text-[var(--color-bp-400)]">{a.fn}</span><span class="text-[var(--color-ink-2)]">({a.args})</span></div>
            ))}
          </div>
          <div data-ftx-panel="v2" class="mt-3" hidden>
            <div class="whitespace-nowrap text-[var(--color-ink-3)]">// post-conditions: one ERC-8211 batch, one call</div>
            <div class="whitespace-nowrap"><span class="text-[var(--color-bp-400)]">assertComposable</span><span class="text-[var(--color-ink-2)]">([</span></div>
            {assertsV2.map((a) => (
              <div class="whitespace-pre"><span class="text-[var(--color-ok)]">&nbsp;&nbsp;&#10003; </span><span class="text-[var(--color-bp-400)]">{a.fn}</span><span class="text-[var(--color-ink-2)]">({a.args}){a.pad}</span><span class="text-[var(--color-ok)]">{a.op}</span><span class="text-[var(--color-ink-2)]">{a.opPad}{a.val}</span></div>
            ))}
            <div class="whitespace-nowrap text-[var(--color-ink-2)]">])</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ftx-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .ftx-select {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 5px 10px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-bp-400) 40%, transparent);
    background: color-mix(in srgb, var(--color-bp-500) 8%, transparent);
    color: var(--color-bp-400);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .ftx-select:hover {
    border-color: color-mix(in srgb, var(--color-bp-400) 70%, transparent);
    background: color-mix(in srgb, var(--color-bp-500) 14%, transparent);
  }
  .ftx-select:focus-visible {
    outline: 2px solid var(--color-bp-400);
    outline-offset: 2px;
  }
  .ftx-select-chevron {
    transition: transform 0.15s;
  }
  .ftx-select[aria-expanded='true'] .ftx-select-chevron {
    transform: rotate(180deg);
  }
  .ftx-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--color-ink-3) 25%, transparent);
    background: var(--color-surface-2);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-bp-950) 25%, transparent);
  }
  .ftx-menu[hidden] {
    display: none;
  }
  .ftx-option {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    text-align: left;
    white-space: nowrap;
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--color-ink-2);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .ftx-option:hover {
    background: color-mix(in srgb, var(--color-bp-500) 10%, transparent);
    color: var(--color-ink);
  }
  .ftx-option[aria-selected='true'] {
    color: var(--color-bp-400);
  }
</style>

<script>
  const section = document.getElementById('featured');
  const wrap = section?.querySelector<HTMLElement>('.ftx-select-wrap');
  const trigger = wrap?.querySelector<HTMLButtonElement>('.ftx-select');
  const menu = wrap?.querySelector<HTMLElement>('.ftx-menu');
  const current = wrap?.querySelector<HTMLElement>('[data-ftx-current]');

  const setOpen = (open: boolean) => {
    if (!trigger || !menu) return;
    menu.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
  };

  trigger?.addEventListener('click', () => setOpen(menu?.hidden ?? true));

  document.addEventListener('click', (e) => {
    if (wrap && !wrap.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  wrap?.querySelectorAll<HTMLButtonElement>('[data-ftx-option]').forEach((opt) => {
    opt.addEventListener('click', () => {
      const key = opt.dataset.ftxOption;
      if (current) current.textContent = opt.textContent;
      wrap?.querySelectorAll<HTMLButtonElement>('[data-ftx-option]').forEach((o) => {
        o.setAttribute('aria-selected', String(o === opt));
      });
      section?.querySelectorAll<HTMLElement>('[data-ftx-panel]').forEach((p) => {
        p.hidden = p.dataset.ftxPanel !== key;
      });
      setOpen(false);
    });
  });
</script>
