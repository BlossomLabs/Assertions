  lemma Constants()
    ensures (115792089210356248756420345214020892766250353992003419616917011526809519390720 as bv256) == 115792089210356248756420345214020892766250353992003419616917011526809519390720
    ensures ((115792089210356248756420345214020892766250353992003419616917011526809519390720 as bv256) as nat) == 115792089210356248756420345214020892766250353992003419616917011526809519390720
    ensures (114868520915462442597141167955500076753242771306388937253322076133114393919488 as bv256) == 114868520915462442597141167955500076753242771306388937253322076133114393919488
    ensures ((114868520915462442597141167955500076753242771306388937253322076133114393919488 as bv256) as nat) == 114868520915462442597141167955500076753242771306388937253322076133114393919488
  {}
  lemma NatDifferent(left: bv256, right: bv256)
    requires left != right
    ensures (left as nat) != (right as nat)
  {
    C.Inverse256(left); C.Inverse256(right);
  }
  lemma GuardRange(word: G.Word)
    requires 114868520915462442597141167955500076753242771306388937253322076133114393919488 <= word < 114868520942422389264291807750167091840262401980026081675862648614218004168704
    ensures 114868520915462442597141167955500076753242771306388937253322076133114393919488 <= (word as bv256) < 114868520942422389264291807750167091840262401980026081675862648614218004168704
  {
    A.WordIdentity(word);
    if (word as bv256) < 114868520915462442597141167955500076753242771306388937253322076133114393919488 { BelowHeader(word as bv256); assert false; }
    if (word as bv256) >= 114868520942422389264291807750167091840262401980026081675862648614218004168704 { AtLeastNext(word as bv256); assert false; }
  }
  lemma OtherRange(word: G.Word)
